  "ledger": {
    "onboarding-control-center": {
      "rationale": "Preserve the first-run product guidance while removing copied application UI.",
      "replacement": "@applik8s/start-agentic/react owns the browser-safe onboarding component and links to the maintained operations surface."
    },
    "safe-configuration-guide": {
      "rationale": "Make the safe local path the default and keep production configuration progressive.",
      "replacement": "Starter is explicitly credential-free and non-production; plan and dedicated/external progression are framework-maintained."
    },
    "health-readiness": {
      "rationale": "Replace route-local health inference with provider and workflow observations.",
      "replacement": "@applik8s/operations-ui projects bounded operational observations without exposing raw provider evidence."
    },
    "identity-session": {
      "rationale": "Keep authenticated session behavior while replacing application-copied auth routing.",
      "replacement": "@applik8s/identity owns the provider-neutral session contract and server boundary."
    },
    "application-owned-tenancy": {
      "rationale": "Retain product-owned organization and tenant semantics without making tenancy a framework primitive.",
      "replacement": "Applications declare their own models, identity relationships, authority scopes, and provider qualifications."
    },
    "usage-entitlements": {
      "rationale": "Preserve usage and entitlement extension seams as optional maintained application modules.",
      "replacement": "@applik8s/usage supplies native relational models without imposing billing or tenancy policy."
    },
    "conversation-inbox": {
      "rationale": "Preserve conversation, message, run, event, and memory behavior with one model declaration per entity.",
      "replacement": "@applik8s/conversations supplies Drizzle-native Applik8s models and ordinary function-native operations."
    },
    "run-administration": {
      "rationale": "Preserve operator-facing run visibility without exposing secrets or provider-native records.",
      "replacement": "@applik8s/operations-ui presents redacted maintained run and workflow observations."
    },
    "operation-authority-administration": {
      "rationale": "Replace string role-policy registries with typed operation authority.",
      "replacement": "@applik8s/operations owns runtime roles, grants, receipts, and bounded administrative operations."
    },
    "evaluation-history": {
      "rationale": "Preserve dataset, scorer, run, case, and result history as composable domain models.",
      "replacement": "@applik8s/evals supplies maintained native models that applications attach to their selected database."
    },
    "artifact-provenance": {
      "rationale": "Preserve artifact metadata and provenance while separating bytes into object storage.",
      "replacement": "@applik8s/artifacts supplies metadata models and Applik8s object-store capabilities own payload transport."
    },
    "durable-review-workflow": {
      "rationale": "Preserve review durability while replacing provider-specific workflow and approval plumbing.",
      "replacement": "Function-native workflows emit typed durable signals as events and Hatchet remains an injected execution provider."
    }
  },
