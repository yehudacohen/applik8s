{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@applik8s/core": ["packages/core/src/index.ts"],
      "@applik8s/deployment-contract": ["packages/deployment-contract/src/index.ts"],
      "@applik8s/deployment-compiler": ["packages/deployment-compiler/src/index.ts"],
      "@applik8s/deployment-typekro": ["packages/deployment-typekro/src/index.ts"],
      "@applik8s/deployment-provider-harbor": ["packages/deployment-provider-harbor/src/index.ts"],
      "@applik8s/deployment-provider-kubernetes": ["packages/deployment-provider-kubernetes/src/index.ts"],
      "@applik8s/deployment-provider-oci": ["packages/deployment-provider-oci/src/index.ts"],
      "@applik8s/deployment-alchemy": ["packages/deployment-alchemy/src/index.ts"],
      "@applik8s/cli": ["packages/cli/src/cli.ts"],
      "@applik8s/applik8s": ["packages/applik8s/src/index.ts"],
      "@applik8s/applik8s/deployment-registry": ["packages/applik8s/src/deployment-registry.ts"],
      "@applik8s/applik8s/dsl": ["packages/applik8s/src/dsl.ts"],
      "@applik8s/applik8s/drizzle": ["packages/applik8s/src/drizzle.ts"],
      "@applik8s/applik8s/dns": ["packages/applik8s/src/dns.ts"],
      "@applik8s/applik8s/typekro": ["packages/applik8s/src/typekro.ts"],
      "@applik8s/applik8s/factories": ["packages/applik8s/src/factories.ts"],
      "@applik8s/applik8s/factories/*": ["packages/applik8s/src/factories/*.ts"],
      "@applik8s/applik8s/processor-runtime": ["packages/applik8s/src/processor-runtime.ts"],
      "@applik8s/applik8s/event-log-runtime": ["packages/applik8s/src/event-log-runtime.ts"],
      "@applik8s/applik8s/postgres-runtime-contract": ["packages/applik8s/src/postgres-runtime-contract.ts"],
      "@applik8s/applik8s/reactive-runtime": ["packages/applik8s/src/reactive-runtime.ts"],
      "@applik8s/applik8s/structured-generation": ["packages/applik8s/src/structured-generation.ts"],
      "@applik8s/applik8s/structured-generation-runtime": ["packages/applik8s/src/structured-generation-runtime.ts"],
      "@applik8s/applik8s/task-operation-runtime": ["packages/applik8s/src/task-operation-runtime.ts"],
      "@applik8s/applik8s/task-query-runtime": ["packages/applik8s/src/task-query-runtime.ts"],
      "@applik8s/client": ["packages/client/src/index.ts"],
      "@applik8s/react": ["packages/react/src/index.ts"],
      "@applik8s/server": ["packages/server/src/index.ts"],
      "@applik8s/vite": ["packages/vite/src/index.ts"],
      "@applik8s/tanstack-start/server": ["packages/tanstack-start/src/server.ts"],
      "@applik8s/tanstack-start/vite": ["packages/tanstack-start/src/vite.ts"],
      "@applik8s/sdk": ["packages/sdk/src/index.ts"],
      "@applik8s/sdk/schema-runtime": ["packages/sdk/src/schema-runtime.ts"],
      "@applik8s/testing": ["packages/testing/src/index.ts"],
      "@applik8s/compiler": ["packages/compiler/src/index.ts"],
      "@applik8s/compiler/diagnostics": ["packages/compiler/src/diagnostics/index.ts"],
      "@applik8s/compiler/kubernetes-schema": ["packages/compiler/src/kubernetes-schema/index.ts"],
      "@applik8s/runtime": ["packages/runtime/src/index.ts"],
      "@applik8s/runtime-s3": ["packages/runtime-s3/src/index.ts"],
      "@applik8s/runtime-hatchet": ["packages/runtime-hatchet/src/index.ts"],
      "@applik8s/runtime-nats": ["packages/runtime-nats/src/index.ts"],
      "@applik8s/runtime-nats/event-log": ["packages/runtime-nats/src/event-log.ts"],
      "@applik8s/runtime-nats/command-processor": ["packages/runtime-nats/src/command-processor.ts"],
      "@applik8s/runtime-kubernetes": ["packages/runtime-kubernetes/src/index.ts"],
      "@applik8s/runtime-postgres": ["packages/runtime-postgres/src/index.ts"],
      "@applik8s/operations": ["packages/operations/src/index.ts"],
      "@applik8s/runtime-contract": ["packages/runtime-contract/src/index.ts"],
      "@applik8s/typekro-adapter": ["packages/typekro-adapter/src/index.ts"],
      "@applik8s/typekro-adapter/targets": ["packages/typekro-adapter/src/operation-targets.ts"],
      "@applik8s/typetainer": ["packages/typetainer/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "vitest.config.ts", "vitest.character.config.ts", "vitest.e2e.config.ts"],
  "exclude": ["node_modules", "dist", "packages/internal-research"]
}
