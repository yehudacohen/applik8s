{
  "name": "@applik8s/notifications",
  "version": "0.7.2",
  "description": "Provider-neutral transactional application notification delivery for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/notifications"
  },
  "exports": {
