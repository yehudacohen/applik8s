{
  "$schema": "https://biomejs.dev/schemas/2.2.2/schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "!src/routeTree.gen.ts",
      "test/**/*.ts",
      "test/**/*.tsx",
      "vite.config.ts",
      "vitest.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  }
}
