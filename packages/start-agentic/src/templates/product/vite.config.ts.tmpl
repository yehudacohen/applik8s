import { applik8sStart } from '@applik8s/tanstack-start/vite';
import { tanstackStart } from '@tanstack/react-start/plugin/vite';
import react from '@vitejs/plugin-react';
import tailwindcss from '@tailwindcss/vite';
import { defineConfig } from 'vite';

export default defineConfig({
  build: {
    rollupOptions: {
      output: {
        // React is stable across the application route graph. Keeping it in a
        // focused vendor chunk prevents the entry chunk from growing whenever
        // an independently loaded product module gains UI behavior.
        manualChunks(id) {
          const moduleId = id.replaceAll('\\', '/');
          if (
            moduleId.includes('/node_modules/react/')
            || moduleId.includes('/node_modules/react-dom/')
            || moduleId.includes('/node_modules/scheduler/')
          ) return 'react-vendor';
          return undefined;
        },
      },
    },
  },
  server: {
    host: process.env.HOST ?? '127.0.0.1',
    port: Number(process.env.PORT ?? '3000'),
  },
  define: {
    __APPLIK8S_BUILD_LINEAGE__: JSON.stringify(
      process.env.APPLIK8S_BUILD_LINEAGE ?? 'development',
    ),
  },
  resolve: { tsconfigPaths: true },
  oxc: { jsx: { development: false } },
  plugins: [
    tailwindcss(),
    tanstackStart(),
    applik8sStart({ application: './src/application.ts' }),
    react(),
  ],
});
