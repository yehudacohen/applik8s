import { createApplicationTanStackConnection } from '@applik8s/ai-tanstack/client';
import { useApplicationIdentitySession } from '@applik8s/react/identity';
import { readAgenticWorkspaceSelection } from '@applik8s/start-agentic/react';
import { agenticAssistantFailureMessage, agenticToolLabel, agenticToolStateLabel } from '@applik8s/start-agentic/product-presentation';
import type { MessagePart } from '@tanstack/ai';
import { useChat } from '@tanstack/ai-react';
import { createFileRoute, Link } from '@tanstack/react-router';
import { type FormEvent, useEffect, useMemo, useState } from 'react';
import { Badge, Button, Card, EmptyState, LiveQueryStatus, PageHeader, RouteState, Skeleton, Textarea } from '../components/ui';
import { ConversationList, DocumentList, WorkspaceAssistant } from '../application';
import { documentExcerpt } from '../components/markdown-document';
import { ProductJourney } from '../features/onboarding/view';
import { productHome } from '../product-home';

export const Route = createFileRoute('/app/')({
  component: CopilotHome,
});

function CopilotHome() {
  const documents = DocumentList({}).useQuery();
  const conversations = ConversationList({}).useQuery();
  const session = useApplicationIdentitySession();
  const [notice, setNotice] = useState<string>();
  const [threadId, setThreadId] = useState<string>();
  useEffect(() => {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const workspace = readAgenticWorkspaceSelection() ?? 'personal';
    const key = `applik8s:copilot:${principal}:${workspace}`;
    const existing = globalThis.localStorage.getItem(key);
    const next = existing ?? crypto.randomUUID();
    if (!existing) globalThis.localStorage.setItem(key, next);
    setThreadId(next);
  }, [session.data?.principal?.id]);
  function beginConversation() {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const next = crypto.randomUUID();
    const workspace = readAgenticWorkspaceSelection() ?? 'personal';
    globalThis.localStorage.setItem(
      `applik8s:copilot:${principal}:${workspace}`,
      next,
    );
    setThreadId(next);
    setNotice('A new persistent conversation is ready. Previous conversations remain in your history.');
  }

  return (
    <div>
      <ProductJourney documents={documents.data ?? []} />
      <PageHeader
        eyebrow={productHome.header.eyebrow}
        title={productHome.header.title}
        description={productHome.header.description}
        action={<Button asChild variant="secondary"><Link to="/app/documents">{productHome.header.documentsAction}</Link></Button>}
      />
      <div className="mb-5"><LiveQueryStatus phase={documents.phase} label="Document updates" onRetry={() => documents.refresh()} /></div>
      {documents.phase === 'error' ? (
        <RouteState
          tone="warning"
          title="Your documents are temporarily unavailable"
          description="Your work is safe. Try loading the workspace again in a moment."
          action={<Button variant="secondary" onClick={() => void documents.refresh()}>Retry documents</Button>}
        />
      ) : (
        <div className="grid items-start gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,.65fr)]">
          <section>
            {threadId ? <WorkspaceAssistantCard key={threadId} threadId={threadId} onSettled={async () => { await Promise.all([documents.refresh(), conversations.refresh()]); }} /> : <Card surface="unstyled" className="border-emerald-900/15 bg-emerald-950 text-emerald-50"><Skeleton className="h-72 bg-white/10" /></Card>}
          </section>
          <section aria-label="Recent work sessions"><Card>
            <div className="flex items-center justify-between gap-3">
              <div><p className="eyebrow">{productHome.recent.eyebrow}</p><h2 id="work-sessions-title" className="mt-1 text-xl font-semibold">{productHome.recent.title}</h2></div>
              <Button type="button" variant="secondary" onClick={beginConversation}>New</Button>
            </div>
            <section aria-label="Work sessions" aria-live="polite" className="mt-6 space-y-3">
              {!documents.data || !conversations.data ? <><Skeleton className="h-24" /><Skeleton className="h-24" /></> : null}
              {documents.data?.length === 0 && conversations.data?.length === 0 ? <EmptyState title={productHome.recent.emptyTitle} description={productHome.recent.emptyDescription} /> : null}
              {conversations.data?.slice(0, 4).map(conversation => {
                const results = documents.data?.filter(document => document.sourceConversationId === conversation.id) ?? [];
                const result = results[0];
                const failed = conversation.runStatus === 'failed' || conversation.runStatus === 'interrupted' || conversation.runStatus === 'cancelled';
                return <Link key={conversation.id} to="/app/conversations/$conversationId" params={{ conversationId: conversation.id }} className="block rounded-xl border border-stone-200 bg-stone-50/60 p-4 text-stone-900 no-underline transition hover:border-emerald-300"><div className="flex items-center justify-between gap-2"><strong className="line-clamp-1">{conversation.title ?? 'Untitled conversation'}</strong>{result ? <Badge tone="success">{results.length} {results.length === 1 ? 'result' : 'results'}</Badge> : failed ? <Badge tone="warning">Needs retry</Badge> : conversation.runStatus === 'completed' ? <Badge>Completed</Badge> : <Badge>In progress</Badge>}</div>{result ? <div className="mt-3 border-l-2 border-emerald-300 pl-3"><span className="block text-xs font-semibold uppercase tracking-wide text-stone-500">Latest document</span><span className="mt-1 block text-sm font-medium">{result.title}</span><span className="mt-1 block line-clamp-2 text-xs leading-5 text-stone-500">{result.summary || documentExcerpt(result.body)}</span></div> : <p className="mt-2 text-sm leading-6 text-stone-600">{failed ? 'The latest assistant attempt ended without an authoritative result. Open it to review the durable failure and retry.' : 'Continue this conversation to create an authoritative result.'}</p>}<small className="mt-3 block text-xs text-stone-500">Updated {new Date(conversation.updatedAt).toLocaleString()}</small></Link>;
              })}
              {documents.data?.filter(document => !document.sourceConversationId || !conversations.data?.some(conversation => conversation.id === document.sourceConversationId)).slice(0, Math.max(0, 4 - (conversations.data?.length ?? 0))).map(document => <Link key={document.id} to="/app/documents/$documentId" params={{ documentId: document.id }} className="block rounded-xl border border-stone-200 bg-stone-50/60 p-4 text-stone-900 no-underline transition hover:border-emerald-300"><div className="flex items-center justify-between gap-2"><strong className="line-clamp-1">{document.title}</strong><Badge tone={document.sourceConversationId ? 'success' : 'neutral'}>{document.sourceConversationId ? 'Agent result' : document.state}</Badge></div><p className="mt-2 line-clamp-2 text-sm leading-6 text-stone-600">{document.summary || documentExcerpt(document.body)}</p><small className="mt-2 block text-xs text-stone-500">{document.sourceConversationId ? 'Created by your workspace agent' : 'Member-created'} · v{document.version}</small></Link>)}
              <div className="flex gap-4 pt-2 text-sm font-semibold"><Link to="/app/documents" className="text-emerald-800">All documents →</Link>{threadId ? <Link to="/app/conversations/$conversationId" params={{ conversationId: threadId }} className="text-emerald-800">Current session →</Link> : null}</div>
            </section>
          </Card></section>
        </div>
      )}
      {notice ? <p role="status" className="mt-4 text-sm text-stone-600">{notice}</p> : null}
    </div>
  );
}

function WorkspaceAssistantCard({ threadId, onSettled }: { readonly threadId: string; readonly onSettled: () => Promise<void> }) {
  const [prompt, setPrompt] = useState('');
  const [lastPrompt, setLastPrompt] = useState<string>();
  const [startedAt, setStartedAt] = useState<number>();
  const [elapsedSeconds, setElapsedSeconds] = useState(0);
  const connection = useMemo(
    () => createApplicationTanStackConnection({ agent: WorkspaceAssistant }),
    [],
  );
  const { messages, sendMessage, isLoading, error, stop } = useChat({
    connection,
    threadId,
  });
  useEffect(() => {
    if (!isLoading || startedAt === undefined) {
      if (!isLoading) setElapsedSeconds(0);
      return;
    }
    const update = () => setElapsedSeconds(Math.floor((Date.now() - startedAt) / 1_000));
    update();
    const timer = globalThis.setInterval(update, 1_000);
    return () => globalThis.clearInterval(timer);
  }, [isLoading, startedAt]);

  async function askAssistant(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const message = prompt.trim();
    if (!message) return;
    setLastPrompt(message);
    setStartedAt(Date.now());
    setPrompt('');
    try {
      await sendMessage(message);
    } finally {
      setStartedAt(undefined);
      await onSettled().catch(() => undefined);
    }
  }

  return <Card surface="unstyled" className="border-emerald-900/15 bg-emerald-950 text-emerald-50" aria-labelledby="assistant-title">
    <p className="eyebrow !text-emerald-300">{productHome.assistant.eyebrow}</p>
    <h2 id="assistant-title" className="mt-1 text-xl font-semibold">{productHome.assistant.title}</h2>
    <p className="mt-2 text-sm leading-6 text-emerald-100/75">{productHome.assistant.description}</p>
    <div className="mt-5 min-h-48 space-y-3 rounded-xl bg-black/15 p-3" aria-live="polite">
      {messages.length === 0 ? <p className="text-sm text-emerald-100/60">The conversation will appear here.</p> : null}
      {messages.filter(message => message.parts.length > 0).map(message => (
        <article key={message.id} className="rounded-lg bg-white/10 p-3 text-sm" data-role={message.role}>
          <strong className="text-xs uppercase tracking-wide text-emerald-200">{message.role}</strong>
          {message.parts.map(part => <AssistantPart key={`${message.id}:${JSON.stringify(part)}`} part={part} />)}
        </article>
      ))}
      {isLoading ? <div role="status" className="rounded-lg border border-emerald-300/20 bg-emerald-300/10 p-3 text-sm text-emerald-50"><strong>{elapsedSeconds > 45 ? 'This is taking longer than expected.' : 'The assistant is working.'}</strong><p className="mt-1 text-emerald-100/70">Tool calls and committed results appear here as the durable run advances. {elapsedSeconds > 45 ? 'You can stop safely; only results already visible in Documents are committed.' : `${elapsedSeconds}s elapsed.`}</p></div> : null}
      {error ? <div role="alert" className="rounded-lg border border-red-300/25 bg-red-950/35 p-3 text-sm text-red-100"><strong>Assistant run ended</strong><p className="mt-1">{agenticAssistantFailureMessage(error)} No result is complete unless it appears in Documents.</p>{lastPrompt ? <Button type="button" variant="ghost" className="mt-2 text-white hover:bg-white/10" onClick={() => setPrompt(lastPrompt)}>Restore prompt</Button> : null}</div> : null}
    </div>
    <form onSubmit={askAssistant} className="mt-4 grid gap-3">
      <label htmlFor="assistant-prompt" className="text-sm font-medium">{productHome.assistant.promptLabel}</label>
      <Textarea id="assistant-prompt" value={prompt} onChange={event => setPrompt(event.currentTarget.value)} disabled={isLoading} placeholder={productHome.assistant.promptPlaceholder} className="border-white/20 bg-white/10 text-white placeholder:text-emerald-100/45" />
      <div className="flex gap-2">
        <Button type="submit" className="bg-emerald-100 text-emerald-950 hover:bg-white" disabled={isLoading || !prompt.trim()}>{isLoading ? 'Working…' : 'Send'}</Button>
        {isLoading ? <Button type="button" variant="ghost" className="text-white hover:bg-white/10" onClick={stop}>Stop</Button> : null}
      </div>
    </form>
  </Card>;
}

function AssistantPart({ part }: { readonly part: MessagePart }) {
  if (part.type === 'text') return <p className="mt-1 whitespace-pre-wrap leading-6">{part.content}</p>;
  if (part.type === 'tool-call') return <p className="mt-2 rounded-md bg-black/15 px-3 py-2 text-xs text-emerald-100"><strong>{agenticToolLabel(part.name)}</strong> · {agenticToolStateLabel(part.state)}</p>;
  if (part.type === 'tool-result') return <p className="mt-2 rounded-md bg-black/15 px-3 py-2 text-xs text-emerald-100">Tool result · {part.error ? 'failed' : agenticToolStateLabel(part.state)}</p>;
  if (part.type === 'thinking') return <p className="mt-2 text-xs text-emerald-100/60">Planning the next step…</p>;
  return null;
}
