import { createApplicationTanStackConnection } from '@applik8s/ai-tanstack/client';
import { useApplicationIdentitySession } from '@applik8s/react/identity';
import { readAgenticWorkspaceSelection } from '@applik8s/start-agentic/react';
import type { MessagePart } from '@tanstack/ai';
import { useChat } from '@tanstack/ai-react';
import { createFileRoute, Link } from '@tanstack/react-router';
import { type FormEvent, useEffect, useMemo, useState } from 'react';
import { Badge, Button, Card, EmptyState, PageHeader, RouteState, Skeleton } from '../components/ui';
import { ConversationList, Document, DocumentList, WorkspaceAssistant } from '../application';
import { ProductJourney } from '../features/onboarding/view';

export const Route = createFileRoute('/app/')({
  component: CopilotHome,
});

function CopilotHome() {
  const documents = DocumentList({}).useQuery();
  const conversations = ConversationList({}).useQuery();
  const createDocument = Document.create.useMutation();
  const session = useApplicationIdentitySession();
  const [body, setBody] = useState('');
  const [notice, setNotice] = useState<string>();
  const [threadId, setThreadId] = useState<string>();
  useEffect(() => {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const workspace = readAgenticWorkspaceSelection() ?? 'personal';
    const key = `applik8s:copilot:${principal}:${workspace}`;
    const existing = globalThis.localStorage.getItem(key);
    const next = existing ?? crypto.randomUUID();
    if (!existing) globalThis.localStorage.setItem(key, next);
    setThreadId(next);
  }, [session.data?.principal?.id]);
  function beginConversation() {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const next = crypto.randomUUID();
    const workspace = readAgenticWorkspaceSelection() ?? 'personal';
    globalThis.localStorage.setItem(
      `applik8s:copilot:${principal}:${workspace}`,
      next,
    );
    setThreadId(next);
    setNotice('A new persistent conversation is ready. Previous conversations remain in your history.');
  }

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    try {
      await createDocument({ body });
      setBody('');
      setNotice('Document committed. The live query will reconcile this list.');
    } catch {
      setNotice('The document was not committed. Check your session and retry.');
    }
  }

  return (
    <div>
      <ProductJourney documentCount={documents.data?.length ?? 0} />
      <PageHeader
        eyebrow="Workspace copilot"
        title="Make useful work appear."
        description="Start with a document yourself, or ask the assistant to use the same typed model operation."
        action={<Badge tone="info">Provider resolved server-side</Badge>}
      />
      {documents.phase === 'error' ? (
        <RouteState
          tone="warning"
          title="Your documents are temporarily unavailable"
          description="The product shell and assistant remain available while the query provider recovers."
          action={<Button variant="secondary" onClick={() => void documents.refresh()}>Retry documents</Button>}
        />
      ) : (
        <div className="grid items-start gap-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,.95fr)]">
          <Card aria-label="Your documents">
            <div className="flex items-center justify-between gap-3">
              <div><p className="eyebrow">Documents</p><h2 id="documents-title" className="mt-1 text-xl font-semibold">Recent work</h2></div>
              <Badge tone={documents.phase === 'reconnecting' ? 'warning' : documents.data?.length ? 'success' : 'neutral'}>
                {documents.phase === 'reconnecting' ? 'Reconnecting…' : `${documents.data?.length ?? 0} documents`}
              </Badge>
            </div>
            <form onSubmit={submit} className="mt-5 grid gap-3">
              <label htmlFor="document-body" className="text-sm font-medium">Create manually</label>
              <textarea id="document-body" value={body} onChange={event => setBody(event.currentTarget.value)} placeholder="Something worth remembering" />
              <Button type="submit" disabled={!body.trim() || createDocument.pending}>
                {createDocument.pending ? 'Saving…' : 'Save document'}
              </Button>
            </form>
            <div aria-label="Documents" aria-live="polite" className="mt-6 space-y-3">
              {!documents.data ? <><Skeleton className="h-20" /><Skeleton className="h-20" /></> : null}
              {documents.data?.length === 0 ? <EmptyState title="No documents yet" description="Your assistant can create the first one through the same typed model operation." /> : null}
              {documents.data?.map(document => (
                <article key={document.id} className="rounded-xl border border-stone-200 bg-stone-50/60 p-4">
                  <p className="whitespace-pre-wrap text-sm leading-6">{document.body}</p>
                  <small className="mt-2 block text-xs text-stone-500">{new Date(document.createdAt).toLocaleString()}</small>
                </article>
              ))}
            </div>
          </Card>
          {threadId ? <WorkspaceAssistantCard key={threadId} threadId={threadId} /> : <Card surface="unstyled" className="border-emerald-900/15 bg-emerald-950 text-emerald-50"><Skeleton className="h-72 bg-white/10" /></Card>}
        </div>
      )}
      <section className="mt-8" aria-labelledby="recent-conversations-title">
        <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
          <h2 id="recent-conversations-title" className="text-xl font-semibold">Continue working</h2>
          <div className="flex items-center gap-3">
            {threadId ? <Link to="/app/conversations/$conversationId" params={{ conversationId: threadId }} className="text-sm font-semibold text-emerald-800">Open current conversation →</Link> : null}
            <Button type="button" variant="secondary" onClick={beginConversation}>New conversation</Button>
          </div>
        </div>
        {conversations.data?.length === 0 ? <EmptyState title="No saved conversations yet" description="Send the assistant a message. The conversation protocol persists its messages and run history under your admitted scope." /> : null}
        <div className="grid gap-3 sm:grid-cols-2">{conversations.data?.slice(0, 4).map(conversation => <Link key={conversation.id} to="/app/conversations/$conversationId" params={{ conversationId: conversation.id }} className="rounded-2xl border border-stone-200 bg-white p-4 text-stone-900 no-underline shadow-sm transition hover:border-emerald-300"><strong>{conversation.title ?? 'Untitled conversation'}</strong><p className="mt-1 text-xs text-stone-500">Updated {new Date(conversation.updatedAt).toLocaleString()}</p></Link>)}</div>
      </section>
      {notice ? <p role="status" className="mt-4 text-sm text-stone-600">{notice}</p> : null}
    </div>
  );
}

function WorkspaceAssistantCard({ threadId }: { readonly threadId: string }) {
  const [prompt, setPrompt] = useState('');
  const [lastPrompt, setLastPrompt] = useState<string>();
  const [startedAt, setStartedAt] = useState<number>();
  const [elapsedSeconds, setElapsedSeconds] = useState(0);
  const connection = useMemo(
    () => createApplicationTanStackConnection({ agent: WorkspaceAssistant }),
    [],
  );
  const { messages, sendMessage, isLoading, error, stop } = useChat({
    connection,
    threadId,
  });
  useEffect(() => {
    if (!isLoading || startedAt === undefined) {
      if (!isLoading) setElapsedSeconds(0);
      return;
    }
    const update = () => setElapsedSeconds(Math.floor((Date.now() - startedAt) / 1_000));
    update();
    const timer = globalThis.setInterval(update, 1_000);
    return () => globalThis.clearInterval(timer);
  }, [isLoading, startedAt]);

  async function askAssistant(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const message = prompt.trim();
    if (!message) return;
    setLastPrompt(message);
    setStartedAt(Date.now());
    setPrompt('');
    try {
      await sendMessage(message);
    } finally {
      setStartedAt(undefined);
    }
  }

  return <Card surface="unstyled" className="border-emerald-900/15 bg-emerald-950 text-emerald-50" aria-labelledby="assistant-title">
    <p className="eyebrow !text-emerald-300">Typed agent</p>
    <h2 id="assistant-title" className="mt-1 text-xl font-semibold">Workspace assistant</h2>
    <p className="mt-2 text-sm leading-6 text-emerald-100/75">Try “Create a document about shipping our first version.” Its tool writes through the same authority and model boundary.</p>
    <div className="mt-5 min-h-48 space-y-3 rounded-xl bg-black/15 p-3" aria-live="polite">
      {messages.length === 0 ? <p className="text-sm text-emerald-100/60">The conversation will appear here.</p> : null}
      {messages.map(message => (
        <article key={message.id} className="rounded-lg bg-white/10 p-3 text-sm" data-role={message.role}>
          <strong className="text-xs uppercase tracking-wide text-emerald-200">{message.role}</strong>
          {message.parts.map((part, index) => <AssistantPart key={index} part={part} />)}
        </article>
      ))}
      {isLoading ? <div role="status" className="rounded-lg border border-emerald-300/20 bg-emerald-300/10 p-3 text-sm text-emerald-50"><strong>{elapsedSeconds > 45 ? 'This is taking longer than expected.' : 'The assistant is working.'}</strong><p className="mt-1 text-emerald-100/70">Tool calls and committed results appear here as the durable run advances. {elapsedSeconds > 45 ? 'You can stop safely; only results already visible in Documents are committed.' : `${elapsedSeconds}s elapsed.`}</p></div> : null}
      {error ? <div role="alert" className="rounded-lg border border-red-300/25 bg-red-950/35 p-3 text-sm text-red-100"><strong>Assistant run ended</strong><p className="mt-1">{assistantFailureMessage(error)} No result is complete unless it appears in Documents.</p>{lastPrompt ? <Button type="button" variant="ghost" className="mt-2 text-white hover:bg-white/10" onClick={() => setPrompt(lastPrompt)}>Restore prompt</Button> : null}</div> : null}
    </div>
    <form onSubmit={askAssistant} className="mt-4 grid gap-3">
      <label htmlFor="assistant-prompt" className="text-sm font-medium">Message</label>
      <textarea id="assistant-prompt" value={prompt} onChange={event => setPrompt(event.currentTarget.value)} disabled={isLoading} placeholder="Create a document about shipping the first version" className="border-white/20 bg-white/10 text-white placeholder:text-emerald-100/45" />
      <div className="flex gap-2">
        <Button type="submit" className="bg-emerald-100 text-emerald-950 hover:bg-white" disabled={isLoading || !prompt.trim()}>{isLoading ? 'Working…' : 'Send'}</Button>
        {isLoading ? <Button type="button" variant="ghost" className="text-white hover:bg-white/10" onClick={stop}>Stop</Button> : null}
      </div>
    </form>
  </Card>;
}

function AssistantPart({ part }: { readonly part: MessagePart }) {
  if (part.type === 'text') return <p className="mt-1 whitespace-pre-wrap leading-6">{part.content}</p>;
  if (part.type === 'tool-call') return <p className="mt-2 rounded-md bg-black/15 px-3 py-2 text-xs text-emerald-100"><strong>{humanizeToolName(part.name)}</strong> · {humanizeToolState(part.state)}</p>;
  if (part.type === 'tool-result') return <p className="mt-2 rounded-md bg-black/15 px-3 py-2 text-xs text-emerald-100">Tool result · {part.error ? 'failed' : humanizeToolState(part.state)}</p>;
  if (part.type === 'thinking') return <p className="mt-2 text-xs text-emerald-100/60">Planning the next admitted step…</p>;
  return null;
}

function humanizeToolName(value: string) {
  return value.replace(/^.*[/:]/, '').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/[-_]+/g, ' ').replace(/^./, character => character.toUpperCase());
}

function humanizeToolState(value: string) {
  return value.replace(/[-_]+/g, ' ');
}

function assistantFailureMessage(error: Error) {
  const message = error.message.toLowerCase();
  if (/credential|unauthorized|\b401\b|\b403\b/.test(message)) return 'The selected inference provider rejected its server-side credential.';
  if (/timeout|abort/.test(message)) return 'The run exceeded its bounded wait or was cancelled.';
  if (/\b5\d\d\b|unavailable|backend|provider|inference|network|fetch/.test(message)) return 'The inference runtime or selected provider is temporarily unavailable.';
  return 'The inference runtime did not return a usable terminal result. Check provider status in Launchpad or retry.';
}
