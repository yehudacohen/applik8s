import { createApplicationTanStackConnection } from '@applik8s/ai-tanstack/client';
import { useApplicationIdentitySession } from '@applik8s/react/identity';
import { useChat } from '@tanstack/ai-react';
import { createFileRoute, Link } from '@tanstack/react-router';
import { type FormEvent, useEffect, useMemo, useState } from 'react';
import { Badge, Button, Card, EmptyState, PageHeader, RouteState, Skeleton } from '../components/ui';
import { ConversationList, Note, NoteList, NotesAssistant } from '../application';
import { ProductJourney } from '../features/onboarding/view';

export const Route = createFileRoute('/app/')({
  component: CopilotHome,
});

function CopilotHome() {
  const notes = NoteList({}).useQuery();
  const conversations = ConversationList({}).useQuery();
  const createNote = Note.create.useMutation();
  const session = useApplicationIdentitySession();
  const [body, setBody] = useState('');
  const [prompt, setPrompt] = useState('');
  const [notice, setNotice] = useState<string>();
  const [threadId, setThreadId] = useState('pending-conversation');
  useEffect(() => {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const key = `applik8s:copilot:${principal}`;
    const existing = globalThis.localStorage.getItem(key);
    const next = existing ?? crypto.randomUUID();
    if (!existing) globalThis.localStorage.setItem(key, next);
    setThreadId(next);
  }, [session.data?.principal?.id]);
  const connection = useMemo(
    () => createApplicationTanStackConnection({ agent: NotesAssistant }),
    [],
  );
  const { messages, sendMessage, isLoading, error, stop, setMessages } = useChat({
    connection,
    threadId,
  });

  function beginConversation() {
    const principal = session.data?.principal?.id;
    if (!principal) return;
    const next = crypto.randomUUID();
    globalThis.localStorage.setItem(`applik8s:copilot:${principal}`, next);
    setThreadId(next);
    setMessages([]);
    setNotice('A new persistent conversation is ready. Previous conversations remain in your history.');
  }

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    try {
      await createNote({ body });
      setBody('');
      setNotice('Note committed. The live query will reconcile this list.');
    } catch {
      setNotice('The note was not committed. Check your session and retry.');
    }
  }

  async function askAssistant(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const message = prompt.trim();
    if (!message) return;
    setPrompt('');
    await sendMessage(message);
  }

  return (
    <div>
      <ProductJourney documentCount={notes.data?.length ?? 0} />
      <PageHeader
        eyebrow="Workspace copilot"
        title="Make useful work appear."
        description="Start with a note yourself, or ask the assistant to use the same typed model operation."
        action={<Badge tone="warning">Local assistant · non-production</Badge>}
      />
      {notes.phase === 'error' ? (
        <RouteState
          tone="warning"
          title="Your notes are temporarily unavailable"
          description="The product shell and assistant remain available while the query provider recovers."
          action={<Button variant="secondary" onClick={() => void notes.refresh()}>Retry notes</Button>}
        />
      ) : (
        <div className="grid items-start gap-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,.95fr)]">
          <Card aria-label="Your notes">
            <div className="flex items-center justify-between gap-3">
              <div><p className="eyebrow">Documents</p><h2 id="notes-title" className="mt-1 text-xl font-semibold">Recent work</h2></div>
              <Badge tone={notes.phase === 'reconnecting' ? 'warning' : notes.data?.length ? 'success' : 'neutral'}>
                {notes.phase === 'reconnecting' ? 'Reconnecting…' : `${notes.data?.length ?? 0} notes`}
              </Badge>
            </div>
            <form onSubmit={submit} className="mt-5 grid gap-3">
              <label htmlFor="note-body" className="text-sm font-medium">Create manually</label>
              <textarea id="note-body" value={body} onChange={event => setBody(event.currentTarget.value)} placeholder="Something worth remembering" />
              <Button type="submit" disabled={!body.trim() || createNote.pending}>
                {createNote.pending ? 'Saving…' : 'Save note'}
              </Button>
            </form>
            <div aria-label="Notes" aria-live="polite" className="mt-6 space-y-3">
              {!notes.data ? <><Skeleton className="h-20" /><Skeleton className="h-20" /></> : null}
              {notes.data?.length === 0 ? <EmptyState title="No documents yet" description="Your assistant can create the first one through the same typed model operation." /> : null}
              {notes.data?.map(note => (
                <article key={note.id} className="rounded-xl border border-stone-200 bg-stone-50/60 p-4">
                  <p className="whitespace-pre-wrap text-sm leading-6">{note.body}</p>
                  <small className="mt-2 block text-xs text-stone-500">{new Date(note.createdAt).toLocaleString()}</small>
                </article>
              ))}
            </div>
          </Card>
          <Card surface="unstyled" className="border-emerald-900/15 bg-emerald-950 text-emerald-50" aria-labelledby="assistant-title">
            <p className="eyebrow !text-emerald-300">Typed agent</p>
            <h2 id="assistant-title" className="mt-1 text-xl font-semibold">Notes assistant</h2>
            <p className="mt-2 text-sm leading-6 text-emerald-100/75">Try “Create a note about shipping our first version.” Its tool writes through the same authority and model boundary.</p>
            <div className="mt-5 min-h-48 space-y-3 rounded-xl bg-black/15 p-3" aria-live="polite">
              {messages.length === 0 ? <p className="text-sm text-emerald-100/60">The conversation will appear here.</p> : null}
              {messages.map(message => (
                <article key={message.id} className="rounded-lg bg-white/10 p-3 text-sm" data-role={message.role}>
                  <strong className="text-xs uppercase tracking-wide text-emerald-200">{message.role}</strong>
                  {message.parts.map((part, index) => part.type === 'text' ? <p className="mt-1 leading-6" key={index}>{part.content}</p> : null)}
                </article>
              ))}
              {error ? <p role="alert" className="text-sm text-red-200">The assistant could not complete this request. Your product data was not changed unless a committed note appears.</p> : null}
            </div>
            <form onSubmit={askAssistant} className="mt-4 grid gap-3">
              <label htmlFor="assistant-prompt" className="text-sm font-medium">Message</label>
              <textarea id="assistant-prompt" value={prompt} onChange={event => setPrompt(event.currentTarget.value)} disabled={isLoading || threadId === 'pending-conversation'} placeholder="Create a note about shipping the first version" className="border-white/20 bg-white/10 text-white placeholder:text-emerald-100/45" />
              <div className="flex gap-2">
                <Button type="submit" className="bg-emerald-100 text-emerald-950 hover:bg-white" disabled={isLoading || !prompt.trim()}>{isLoading ? 'Working…' : 'Send'}</Button>
                {isLoading ? <Button type="button" variant="ghost" className="text-white hover:bg-white/10" onClick={stop}>Stop</Button> : null}
              </div>
            </form>
          </Card>
        </div>
      )}
      <section className="mt-8" aria-labelledby="recent-conversations-title">
        <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
          <h2 id="recent-conversations-title" className="text-xl font-semibold">Continue working</h2>
          <div className="flex items-center gap-3">
            {threadId !== 'pending-conversation' ? <Link to="/app/conversations/$conversationId" params={{ conversationId: threadId }} className="text-sm font-semibold text-emerald-800">Open current conversation →</Link> : null}
            <Button type="button" variant="secondary" onClick={beginConversation}>New conversation</Button>
          </div>
        </div>
        {conversations.data?.length === 0 ? <EmptyState title="No saved conversations yet" description="Send the assistant a message. The conversation protocol persists its messages and run history under your admitted scope." /> : null}
        <div className="grid gap-3 sm:grid-cols-2">{conversations.data?.slice(0, 4).map(conversation => <Link key={conversation.id} to="/app/conversations/$conversationId" params={{ conversationId: conversation.id }} className="rounded-2xl border border-stone-200 bg-white p-4 text-stone-900 no-underline shadow-sm transition hover:border-emerald-300"><strong>{conversation.title ?? 'Untitled conversation'}</strong><p className="mt-1 text-xs text-stone-500">Updated {new Date(conversation.updatedAt).toLocaleString()}</p></Link>)}</div>
      </section>
      {notice ? <p role="status" className="mt-4 text-sm text-stone-600">{notice}</p> : null}
    </div>
  );
}
