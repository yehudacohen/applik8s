import { useApplicationIdentitySession } from '@applik8s/react/identity';
import { createFileRoute, Link, Outlet } from '@tanstack/react-router';
import { Button, RouteState } from '../components/ui';
import { RouteNotFound } from './-route-state';

export const Route = createFileRoute('/admin')({
  notFoundComponent: RouteNotFound,
  component: AdminBoundary,
});

function AdminBoundary() {
  const session = useApplicationIdentitySession();
  if (!session.data) return <RouteState title="Loading administration" description="Application authority is being resolved." />;
  if (session.data?.capabilities?.applicationOperations !== true) return <RouteState tone="warning" title="Application-operator access required" description="Workspace ownership does not grant product-wide administration." action={<Button asChild><Link to="/app">Return to product</Link></Button>} />;
  return <Outlet />;
}
