import { Link } from '@tanstack/react-router';
import { type FormEvent, useEffect, useState } from 'react';
import {
  AgentEvaluationRuns,
  AgentProfile,
  AgentProfileList,
  KnowledgeSources,
} from '../../application';
import {
  Badge,
  Button,
  Card,
  Checkbox,
  EmptyState,
  Input,
  PageHeader,
  RouteState,
  Skeleton,
  Textarea,
} from '../../components/ui';

const defaultInstructions = 'Produce useful, editable workspace documents. Use typed document tools for durable results, explain consequential actions, and never claim completion before the authoritative write succeeds.';
const availableTools = ['Document.create', 'Document.update'] as const;
type AvailableTool = typeof availableTools[number];

export function AgentsView() {
  const profiles = AgentProfileList({}).useQuery();
  const knowledge = KnowledgeSources({}).useQuery();
  const create = AgentProfile.create.useMutation();
  const [selectedId, setSelectedId] = useState<string>();
  const selected = profiles.data?.find(profile => profile.id === selectedId)
    ?? profiles.data?.[0];
  const evaluations = AgentEvaluationRuns(selected ? { agentId: selected.id } : {}).useQuery();
  const runtimeQualified = selected?.qualifiedVersion === selected?.version
    && (selected?.qualificationScore ?? 0) >= 1;
  const update = AgentProfile.update.useMutation({ expectedRevision: () => selected?.revision });
  const [name, setName] = useState('Workspace assistant');
  const [description, setDescription] = useState('Turns goals into durable documents and reviewable work.');
  const [instructions, setInstructions] = useState(defaultInstructions);
  const [tools, setTools] = useState<readonly AvailableTool[]>([...availableTools]);
  const [knowledgeSourceIds, setKnowledgeSourceIds] = useState<readonly string[]>([]);
  const [memoryWindowMessages, setMemoryWindowMessages] = useState(100);
  const [maximumTurns, setMaximumTurns] = useState(5);
  const [maximumToolCalls, setMaximumToolCalls] = useState(8);
  const [outputContract, setOutputContract] = useState('Create or update an authoritative workspace Document when the request asks for a deliverable.');
  const [notice, setNotice] = useState<string>();

  useEffect(() => {
    if (!selected) return;
    setSelectedId(selected.id);
    setName(selected.name);
    setDescription(selected.description);
    setInstructions(selected.instructions);
    setTools(selected.tools.filter((tool): tool is AvailableTool => (
      tool === 'Document.create' || tool === 'Document.update'
    )));
    setKnowledgeSourceIds(selected.knowledgeSourceIds);
    setMemoryWindowMessages(selected.memoryWindowMessages);
    setMaximumTurns(selected.maximumTurns);
    setMaximumToolCalls(selected.maximumToolCalls);
    setOutputContract(selected.outputContract);
  }, [selected]);
  useEffect(() => {
    if (selected?.id) void evaluations.refresh();
  }, [selected?.id, evaluations.refresh]);

  async function save(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    try {
      if (selected?.state === 'published' || selected?.state === 'retired') {
        const created = await create({
          slug: selected.slug,
          name: name.trim(),
          description: description.trim(),
          instructions,
          logicalModel: selected.logicalModel,
          tools: [...tools],
          knowledgeSourceIds: [...knowledgeSourceIds],
          memoryWindowMessages,
          maximumTurns,
          maximumToolCalls,
          outputContract,
        });
        setSelectedId(created.value.id);
      } else if (selected) {
        await update({
          identity: selected.id,
          patch: {
            name: name.trim(),
            description: description.trim(),
            instructions,
            tools: [...tools],
            knowledgeSourceIds: [...knowledgeSourceIds],
            memoryWindowMessages,
            maximumTurns,
            maximumToolCalls,
            outputContract,
            state: 'draft',
          },
        });
      } else {
        await create({
          slug: 'workspace-assistant',
          name: name.trim(),
          description: description.trim(),
          instructions,
          logicalModel: 'fast',
          tools: [...tools],
          knowledgeSourceIds: [...knowledgeSourceIds],
          memoryWindowMessages,
          maximumTurns,
          maximumToolCalls,
          outputContract,
        });
      }
      await profiles.refresh();
      setNotice(
        selected?.state === 'published' || selected?.state === 'retired'
          ? 'A new draft was created; the published version remains active.'
          : 'Draft saved. Publish it when new agent runs should use this behavior.',
      );
    } catch {
      setNotice('The draft was not saved. Refresh and retry.');
    }
  }

  async function publish() {
    if (!selected) return;
    try {
      await update({ identity: selected.id, patch: { state: 'published' } });
      await profiles.refresh();
      setNotice('Published. New Workspace assistant runs now resolve this profile.');
    } catch {
      setNotice('Publishing failed. This exact revision must pass its evaluation gate first.');
    }
  }

  async function retire() {
    if (selected?.state !== 'published') return;
    try {
      await update({ identity: selected.id, patch: { state: 'retired' } });
      await profiles.refresh();
      setNotice('Retired. Existing evidence remains; new runs use the next published version or the maintained default.');
    } catch {
      setNotice('The published version could not be retired. Refresh and retry.');
    }
  }

  return (
    <div>
      <PageHeader
        eyebrow="Agent workbench"
        title="Agents"
        description="Configure application-owned instructions, typed tool grants, and grounded knowledge; evaluate an exact revision before publishing it."
        action={selected ? <Badge tone={selected.state === 'published' ? 'success' : 'warning'}>{selected.state}</Badge> : null}
      />
      <nav aria-label="Agent release journey" className="mb-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
        <JourneyStep number="1" title="Define" detail={selected ? `Revision ${selected.version}` : 'Create a draft'} ready={Boolean(selected)} />
        <JourneyStep number="2" title="Ground" detail={`${knowledgeSourceIds.length} source${knowledgeSourceIds.length === 1 ? '' : 's'}`} ready={knowledgeSourceIds.length > 0} to="/app/knowledge" />
        <JourneyStep number="3" title="Connect" detail="Typed authority" ready={tools.length > 0} to="/app/integrations" />
        <JourneyStep number="4" title="Evaluate" detail={runtimeQualified ? 'Runtime exercised' : `${evaluations.data?.length ?? 0} evaluation${evaluations.data?.length === 1 ? '' : 's'}`} ready={runtimeQualified} to="/app/evaluations" />
        <JourneyStep number="5" title="Release" detail={selected?.state === 'published' ? 'Serving traffic' : 'Not published'} ready={selected?.state === 'published'} />
      </nav>
      {profiles.phase === 'error' ? <RouteState tone="warning" title="Agents are temporarily unavailable" description="Your agent definitions are safe. Retry the Builder connection." action={<Button variant="secondary" onClick={() => void profiles.refresh()}>Retry</Button>} /> : null}
      {profiles.data === undefined && profiles.phase !== 'error' ? <Skeleton className="h-80" /> : profiles.data ? (
        <div className="grid gap-5 lg:grid-cols-[16rem_minmax(0,1fr)]">
          <Card>
            <p className="eyebrow">Agent versions</p>
            <div className="mt-3 space-y-2">
              {profiles.data.map(profile => (
                <Button
                  key={profile.id}
                  type="button"
                  className="w-full min-w-0 justify-start overflow-hidden rounded-xl border border-stone-200 p-3 text-left transition hover:border-emerald-300"
                  onClick={() => setSelectedId(profile.id)}
                >
                  <span className="min-w-0"><strong className="block truncate">{profile.name}</strong>
                  <span className="block truncate text-xs text-stone-500">{profile.state} · v{profile.version}</span></span>
                </Button>
              ))}
            </div>
            {profiles.data.length === 0 ? <EmptyState title="Use the built-in assistant" description="Save the form to create the first application-owned profile." /> : null}
          </Card>
          <Card>
            <form onSubmit={save} className="grid gap-4">
              <div><p className="eyebrow">{selected ? 'Configure version' : 'Create profile'}</p><h2 className="mt-1 text-xl font-semibold">Workspace assistant</h2></div>
              <label className="text-sm font-medium">Name<Input className="mt-2" value={name} onChange={event => setName(event.currentTarget.value)} /></label>
              <label className="text-sm font-medium">Description<Textarea className="mt-2 min-h-24" value={description} onChange={event => setDescription(event.currentTarget.value)} /></label>
              <label className="text-sm font-medium">Instructions<Textarea className="mt-2 min-h-64 font-mono text-sm leading-6" value={instructions} onChange={event => setInstructions(event.currentTarget.value)} /></label>
              <fieldset className="rounded-xl border border-stone-200 p-4">
                <legend className="px-1 text-sm font-semibold">Typed tools</legend>
                <p className="mb-3 text-xs leading-5 text-stone-500">Selections resolve to compiled operation handles. Unknown or unavailable tools fail before inference starts.</p>
                {availableTools.map(tool => <label key={tool} className="flex items-center gap-3 py-2 text-sm"><Checkbox checked={tools.includes(tool)} onCheckedChange={checked => setTools(current => checked === true ? [...current, tool] : current.filter(candidate => candidate !== tool))} /><span>{tool}</span></label>)}
              </fieldset>
              <fieldset className="rounded-xl border border-stone-200 p-4"><legend className="px-1 text-sm font-semibold">Execution contract</legend><label className="mt-2 block text-sm font-medium">Authoritative output<Textarea className="mt-2 min-h-24" value={outputContract} onChange={event => setOutputContract(event.currentTarget.value)} /></label><div className="mt-4 grid gap-3 sm:grid-cols-3"><label className="text-sm font-medium">Memory messages<Input className="mt-2" type="number" min={1} max={1000} value={memoryWindowMessages} onChange={event => setMemoryWindowMessages(Number(event.currentTarget.value))} /></label><label className="text-sm font-medium">Maximum turns<Input className="mt-2" type="number" min={1} max={20} value={maximumTurns} onChange={event => setMaximumTurns(Number(event.currentTarget.value))} /></label><label className="text-sm font-medium">Tool-call budget<Input className="mt-2" type="number" min={1} max={100} value={maximumToolCalls} onChange={event => setMaximumToolCalls(Number(event.currentTarget.value))} /></label></div><p className="mt-3 text-xs leading-5 text-stone-500">These budgets are enforced by the application-owned agent loop, not merely displayed as configuration.</p></fieldset>
              <fieldset className="rounded-xl border border-stone-200 p-4">
                <legend className="px-1 text-sm font-semibold">Knowledge access</legend>
                <p className="mb-3 text-xs leading-5 text-stone-500">Select exact workspace sources for this version. Leave all clear to use every enabled source.</p>
                {knowledge.data?.map(source => <label key={source.id} className="flex items-start gap-3 py-2 text-sm"><Checkbox checked={knowledgeSourceIds.includes(source.id)} onCheckedChange={checked => setKnowledgeSourceIds(current => checked === true ? [...current, source.id] : current.filter(id => id !== source.id))} /><span><strong className="block">{source.title}</strong><span className="text-xs text-stone-500">{source.state} · {source.kind}</span></span></label>)}
                {knowledge.data?.length === 0 ? <p className="text-sm text-stone-500">No workspace sources are available. Add them in Knowledge.</p> : null}
              </fieldset>
              <div className="rounded-xl bg-stone-50 p-4 text-sm"><strong>Logical model</strong><p className="mt-1 text-stone-600">fast · qualified at deployment</p></div>
              {selected ? <div className="flex items-center justify-between gap-3 rounded-xl border border-stone-200 p-4 text-sm"><div><strong>Deterministic runtime gate</strong><p className="mt-1 text-stone-600">{runtimeQualified ? 'This exact revision executed through the native agent loop and expected typed operations.' : 'Definition checks alone do not unlock publication. Run the deterministic runtime gate.'}</p></div><div className="flex items-center gap-2"><Badge tone={runtimeQualified ? 'success' : 'warning'}>{runtimeQualified ? 'Passed' : 'Required'}</Badge><Link to="/app/evaluations" className="font-semibold text-emerald-800">Open</Link></div></div> : null}
              <div className="flex flex-wrap gap-2">
                <Button type="submit" disabled={create.pending || update.pending || !name.trim() || !instructions.trim() || tools.length === 0}>{selected?.state === 'published' || selected?.state === 'retired' ? 'Create new draft' : 'Save draft'}</Button>
                {selected?.state === 'draft' ? <Button type="button" variant="secondary" disabled={!runtimeQualified} onClick={() => void publish()}>Publish</Button> : null}
                {selected?.state === 'published' ? <Button type="button" variant="ghost" onClick={() => void retire()}>Retire version</Button> : null}
              </div>
              {notice ? <p role="status" className="text-sm text-stone-600">{notice}</p> : null}
            </form>
          </Card>
        </div>
      ) : null}
    </div>
  );
}

function JourneyStep({ number, title, detail, ready, to }: { readonly number: string; readonly title: string; readonly detail: string; readonly ready: boolean; readonly to?: '/app/knowledge' | '/app/integrations' | '/app/evaluations' }) {
  const content = <><div className="flex items-center justify-between gap-2"><span className="text-xs font-semibold text-stone-500">{number}</span><Badge tone={ready ? 'success' : 'neutral'}>{ready ? 'Ready' : 'Next'}</Badge></div><strong className="mt-3 block">{title}</strong><span className="mt-1 block text-xs text-stone-500">{detail}</span></>;
  const className = `rounded-2xl border p-4 text-stone-900 no-underline transition ${ready ? 'border-emerald-200 bg-emerald-50/60' : 'border-stone-200 bg-white'} ${to ? 'hover:border-emerald-400' : ''}`;
  return to ? <Link to={to} className={className}>{content}</Link> : <div className={className}>{content}</div>;
}
