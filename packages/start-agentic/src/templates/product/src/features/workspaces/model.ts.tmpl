import {
  applicationCausalPrincipalContext,
  module,
} from '@applik8s/applik8s';
import { AgenticWorkspaceId } from '@applik8s/start-agentic';
import { type } from 'arktype';
import { application } from '../../app';
import { ApplicationOperator, Notifications } from '../../modules';
import { database } from '../../providers';
import {
  WorkspaceActivity,
  WorkspaceActivityState,
  WorkspaceDigestSchedule,
} from '../runtime/model';
import {
  AIUsageBudgetLedger as AIUsageBudgetLedgerTable,
  AIUsageReservation as AIUsageReservationTable,
  WorkspaceBudgetPolicy as WorkspaceBudgetPolicyTable,
} from '../budgets/models';
import {
  listWorkspaces,
  loadWorkspaceDashboard,
  WorkspaceDashboardResult,
  WorkspaceSummary,
} from './queries';
import {
  Invitation as InvitationTable,
  InvitationRelations,
  Membership as MembershipTable,
  MembershipRelations,
  Workspace as WorkspaceTable,
  WorkspaceRelations,
} from './schema';

export const WorkspaceId = AgenticWorkspaceId;
const WorkspaceMembershipBootstrapSubject = 'workspace-membership-bootstrap';

const workspaces = module(
  'workspaces',
  {
    schema: {
      Workspace: WorkspaceTable,
      Membership: MembershipTable,
      Invitation: InvitationTable,
      WorkspaceRelations,
      MembershipRelations,
      InvitationRelations,
    },
  },
  currentApplication => {
    const WorkspaceMembershipBootstrapIdentity = currentApplication.serviceIdentity(
      'workspace-membership-bootstrap',
    );
    WorkspaceTable.create.beforeCommit(
      { history: true },
      async function establishWorkspaceOwnership(workspace, input, context) {
        const principal = context.principal;
        if (!principal) {
          throw new Error('Workspace creation requires an authenticated identity.');
        }
        if (
          input.id !== undefined
          || input.ownerPrincipalId !== undefined
          || input.state !== undefined
          || input.createdAt !== undefined
        ) {
          throw new Error(
            'Workspace identity, ownership, lifecycle state, and timestamps are server-owned.',
          );
        }
        workspace.patch({
          spec: {
            ownerPrincipalId: applicationCausalPrincipalContext(principal).id,
            state: 'active',
            createdAt: context.now,
          },
        });
      },
    );
    const WorkspaceMembershipBootstrap = WorkspaceTable.on.create(
      {
        processor: { replicas: 1, concurrency: 8 },
        retry: {
          maxAttempts: 5,
          initialDelayMs: 100,
          maxDelayMs: 5_000,
          deadLetter: true,
        },
        budgets: { timeoutMs: 5_000, maxInputBytes: 32_000 },
      },
      async function createOwningMembership(created) {
        await MembershipTable.create({
          workspaceId: created.value.id,
          identityId: created.value.ownerPrincipalId,
          role: 'workspace-owner',
        });
        await WorkspaceDigestSchedule.schedule({
          id: created.value.id,
          revision: '1',
          input: { workspaceId: created.value.id },
          every: '24h',
        });
      },
    );
    MembershipTable.create.beforeCommit(
      { history: true },
      async function protectWorkspaceMembershipCreation(_membership, input, context) {
        if (input.role !== 'workspace-owner') return;
        const principal = context.principal;
        if (
          principal?.kind !== 'execution'
          || principal.serviceIdentity?.subject !== WorkspaceMembershipBootstrapSubject
          || principal.causalPrincipalId !== input.identityId
        ) {
          throw new Error(
            'Workspace ownership is created only by the framework-owned workspace bootstrap.',
          );
        }
      },
    );
    InvitationTable.create.beforeCommit(
      { history: true },
      async function protectWorkspaceInvitationCreation(_invitation, input) {
        if (input.role === 'workspace-owner') {
          throw new Error(
            'Workspace ownership cannot be granted through an invitation.',
          );
        }
      },
    );
    const InvitationDelivery = InvitationTable.on.create(
      {
        processor: { replicas: 1, concurrency: 8 },
        retry: {
          maxAttempts: 8,
          initialDelayMs: 500,
          maxDelayMs: 30_000,
          deadLetter: true,
        },
        budgets: { timeoutMs: 5_000, maxInputBytes: 32_000 },
      },
      async function requestInvitationDelivery(created) {
        await Notifications.request({
          id: `workspace-invitation:${created.value.id}`,
          idempotencyKey: `workspace-invitation:${created.value.id}:created`,
          recipient: { email: created.value.email },
          content: {
            subject: 'You have been invited to a workspace',
            text: [
              'A workspace owner invited you to join their application workspace.',
              `Invitation: ${created.value.id}`,
              `Role: ${created.value.role}`,
              `Expires: ${created.value.expiresAt}`,
              `Open /invitations/${created.value.id} in the application to accept.`,
            ].join('\n'),
          },
          template: { id: 'workspace-invitation', version: 'v1' },
          tags: { workspaceId: created.value.workspaceId },
        });
      },
    );
    InvitationTable.update.beforeCommit(
      { history: true },
      async function acceptWorkspaceInvitation(invitation, input, context) {
        const principal = context.principal;
        if (!principal) {
          throw new Error('Accepting an invitation requires an authenticated identity.');
        }
        const patchKeys = Object.keys(input.patch);
        const accepting = patchKeys.length === 1
          && patchKeys[0] === 'state'
          && invitation.value.state === 'accepted';
        if (!accepting) {
          if (
            context.trustedContext.workspaceId === invitation.value.workspaceId
            && (
              principal.roles?.includes('workspace-owner')
              || principal.roles?.includes('workspace-administrator')
            )
          ) return;
          throw new Error(
            'Invitation recipients may only perform the single-use acceptance transition.',
          );
        }
        if (Date.parse(invitation.value.expiresAt) <= Date.parse(context.now)) {
          throw new Error('This workspace invitation has expired.');
        }
        if (invitation.value.acceptedByPrincipalId) {
          throw new Error('This workspace invitation was already accepted.');
        }
        invitation.patch({
          spec: {
            acceptedByPrincipalId: principal.id,
            acceptedAt: context.now,
          },
        });
        context.send(
          MembershipTable.create,
          {
            workspaceId: invitation.value.workspaceId,
            identityId: principal.id,
            role: invitation.value.role,
          },
          {
            targetKey: `${invitation.value.workspaceId}:${principal.id}`,
          },
        );
      },
    );
    MembershipTable.update.beforeCommit(
      { history: true },
      async function protectMembershipRole(member, input) {
        if (member.value.role === 'workspace-owner') {
          throw new Error('Workspace ownership cannot be changed through membership role management.');
        }
        const fields = Object.keys(input.patch);
        if (fields.length !== 1 || fields[0] !== 'role' || input.patch.role === 'workspace-owner') {
          throw new Error('Membership updates may only select administrator or member.');
        }
      },
    );
    MembershipTable.delete.beforeCommit(
      { history: true },
      async function protectOwningMembership(member) {
        if (member.value.role === 'workspace-owner') {
          throw new Error('Transfer workspace ownership before removing the owner.');
        }
      },
    );
    WorkspaceTable.update.beforeCommit(
      { history: true },
      async function protectWorkspaceUpdate(_workspace, input, context) {
        const fields = Object.keys(input.patch);
        if (
          fields.length === 1
          && fields[0] === 'state'
          && context.principal?.roles?.includes('application-operator')
        ) return;
        if (fields.length === 0 || fields.some(field => field !== 'name' && field !== 'slug')) {
          throw new Error('Workspace updates may change only its name or slug.');
        }
      },
    );
    const WorkspaceList = WorkspaceTable.view(
      {
        input: type({}),
        output: WorkspaceSummary.array(),
        database,
        authorize: ({ principal }) => principal.id.length > 0,
        budgets: { timeoutMs: 2_000, maxRows: 100, maxResultBytes: 128_000 },
      },
      listWorkspaces,
    );
    const WorkspaceDashboard = WorkspaceTable.view(
      {
        input: type({ workspaceId: 'string' }),
        output: WorkspaceDashboardResult,
        database,
        reads: [
          MembershipTable,
          InvitationTable,
          Notifications.NotificationRequest,
        ],
        authorize: ({ principal }) => principal.id.length > 0,
        budgets: { timeoutMs: 2_000, maxRows: 500, maxResultBytes: 256_000 },
      },
      loadWorkspaceDashboard,
    );
    const WorkspaceActivitySnapshot = currentApplication.query(
      'workspace.activity.v1',
      {
        input: type({ workspaceId: 'string' }),
        output: WorkspaceActivityState,
        database,
        context: [AgenticWorkspaceId],
        reads: [WorkspaceTable],
        authorize: ({ principal, context, input }) =>
          principal.id.length > 0 && context.workspaceId === input.workspaceId,
        run: async ({ input }) =>
          WorkspaceActivity.snapshot(input.workspaceId, {}),
      },
    );

    const Authenticated = currentApplication.role('authenticated');
    const Owner = currentApplication.role('workspace-owner');
    const Administrator = currentApplication.role('workspace-administrator');
    const Member = currentApplication.role('workspace-member');
    Authenticated.can(
      WorkspaceTable.create.all(),
      InvitationTable.update.all(),
      WorkspaceList,
      // This view performs its own principal-scoped membership join. Direct
      // SSR navigation must not depend on a browser selector cookie already
      // existing; workspace mutations remain trusted-context constrained.
      WorkspaceDashboard,
    );
    Owner.can(
      WorkspaceTable.update.where(workspace => workspace.id.eq(WorkspaceId)),
      WorkspaceTable.delete.where(workspace => workspace.id.eq(WorkspaceId)),
      MembershipTable.create.where(member => member.workspaceId.eq(WorkspaceId)),
      MembershipTable.update.where(member => member.workspaceId.eq(WorkspaceId)),
      MembershipTable.delete.where(member => member.workspaceId.eq(WorkspaceId)),
      InvitationTable.create.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      InvitationTable.update.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      InvitationTable.delete.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      WorkspaceBudgetPolicyTable.create.where(policy => policy.workspaceId.eq(WorkspaceId)),
      WorkspaceBudgetPolicyTable.update.where(policy => policy.workspaceId.eq(WorkspaceId)),
      WorkspaceList,
      WorkspaceDashboard,
    );
    Administrator.can(
      WorkspaceTable.update.where(workspace => workspace.id.eq(WorkspaceId)),
      MembershipTable.create.where(member => member.workspaceId.eq(WorkspaceId)),
      MembershipTable.update.where(member => member.workspaceId.eq(WorkspaceId)),
      MembershipTable.delete.where(member => member.workspaceId.eq(WorkspaceId)),
      InvitationTable.create.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      InvitationTable.update.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      InvitationTable.delete.where(invitation => invitation.workspaceId.eq(WorkspaceId)),
      WorkspaceBudgetPolicyTable.create.where(policy => policy.workspaceId.eq(WorkspaceId)),
      WorkspaceBudgetPolicyTable.update.where(policy => policy.workspaceId.eq(WorkspaceId)),
      WorkspaceList,
      WorkspaceDashboard,
    );
    Member.can(WorkspaceList, WorkspaceDashboard);
    WorkspaceMembershipBootstrapIdentity.can(MembershipTable.create.all());
    ApplicationOperator.can(
      WorkspaceTable.update.all(),
      WorkspaceList,
      WorkspaceDashboard,
    );

    return {
      Workspace: WorkspaceTable,
      WorkspaceBudgetPolicy: WorkspaceBudgetPolicyTable,
      AIUsageBudgetLedger: AIUsageBudgetLedgerTable,
      AIUsageReservation: AIUsageReservationTable,
      Membership: MembershipTable,
      Invitation: InvitationTable,
      AcceptInvitation: InvitationTable.update,
      WorkspaceList,
      WorkspaceDashboard,
      WorkspaceActivitySnapshot,
      WorkspaceMembershipBootstrap,
      InvitationDelivery,
      Authenticated,
      Owner,
      Administrator,
      Member,
    };
  },
);

export const Workspaces = application.include(workspaces);
export const {
  Workspace,
  WorkspaceBudgetPolicy,
  AIUsageBudgetLedger,
  AIUsageReservation,
  Membership,
  Invitation,
  AcceptInvitation,
  WorkspaceDashboard,
  WorkspaceActivitySnapshot,
  WorkspaceList,
  InvitationDelivery,
  Authenticated,
  Owner,
  Administrator,
  Member,
} = Workspaces;
