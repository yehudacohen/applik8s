import { selectAgenticWorkspace } from '@applik8s/start-agentic/react';
import { type FormEvent, useState } from 'react';
import { Badge, Button, Card, EmptyState, Input, PageHeader, RouteState, Select } from '../../components/ui';
import {
  DataLifecycleRequest,
  Invitation,
  Membership,
  Workspace,
  WorkspaceDashboard,
  WorkspaceList,
} from '../../application';

export function WorkspaceHome() {
  const workspaces = WorkspaceList({}).useQuery();
  const createWorkspace = Workspace.create.useMutation();
  const [name, setName] = useState('');
  const [slug, setSlug] = useState('');

  async function create(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const created = await createWorkspace({ name, slug });
    const workspaceId = String(created.value.id);
    selectAgenticWorkspace(workspaceId);
    globalThis.location.assign(`/app/workspaces/${workspaceId}`);
  }

  return (
    <div>
      <PageHeader eyebrow="Your teams" title="Workspaces" description="Create a dedicated place for each team, product, or customer and control who can collaborate there." />
      <div className="grid gap-5 lg:grid-cols-[1fr_22rem]"><section aria-label="Your workspaces" className="space-y-3">
        {workspaces.data?.length === 0 ? <EmptyState title="Create your first workspace" description="Bring documents, conversations, agents, and teammates together in one place." /> : null}
        {workspaces.data?.map(workspace => (
          <Card key={workspace.id} className="flex items-center justify-between gap-4">
            <a
              className="font-semibold text-emerald-900"
              href={`/app/workspaces/${workspace.id}`}
              onClick={() => selectAgenticWorkspace(workspace.id)}
            >
              {workspace.name}
            </a>
            <div className="flex gap-2"><Badge>{workspace.role}</Badge><Badge tone={workspace.state === 'active' ? 'success' : 'danger'}>{workspace.state}</Badge></div>
          </Card>
        ))}
      </section>
      <Card><form onSubmit={create} className="grid gap-3">
        <h2 className="text-lg font-semibold">Create a workspace</h2>
        <label htmlFor="workspace-name">Name</label>
        <Input
          id="workspace-name"
          value={name}
          onChange={event => setName(event.currentTarget.value)}
        />
        <label htmlFor="workspace-slug">Slug</label>
        <Input
          id="workspace-slug"
          value={slug}
          onChange={event => setSlug(event.currentTarget.value)}
        />
        <Button
          type="submit"
          disabled={createWorkspace.pending || !name.trim() || !slug.trim()}
        >
          {createWorkspace.pending ? 'Creating…' : 'Create workspace'}
        </Button>
      </form></Card></div>
    </div>
  );
}

export function WorkspaceDashboardView(
  { workspaceId }: { readonly workspaceId: string },
) {
  const dashboard = WorkspaceDashboard({ workspaceId }).useQuery();
  const createInvitation = Invitation.create.useMutation();
  const updateInvitation = Invitation.update.useMutation();
  const updateMembership = Membership.update.useMutation();
  const deleteMembership = Membership.delete.useMutation();
  const requestLifecycle = DataLifecycleRequest.create.useMutation();
  const [email, setEmail] = useState('');
  const [invitationRole, setInvitationRole] = useState<'workspace-administrator' | 'workspace-member'>('workspace-member');
  const [notice, setNotice] = useState<string>();
  const [deleteConfirmation, setDeleteConfirmation] = useState('');

  async function invite(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const expiresAt = new Date(Date.now() + 7 * 24 * 60 * 60 * 1_000)
      .toISOString();
    const invitation = await createInvitation({
      workspaceId,
      email: email.trim(),
      role: invitationRole,
      state: 'pending',
      expiresAt,
    });
    setEmail('');
    setNotice(
      `${globalThis.location.origin}/invitations/${invitation.value.id}`,
    );
  }

  async function requestWorkspaceDeletion() {
    if (deleteConfirmation !== dashboard.data?.workspace.name) return;
    const request = await requestLifecycle({
      scope: 'workspace',
      targetId: workspaceId,
    });
    setDeleteConfirmation('');
    setNotice(`Workspace lifecycle request ${request.value.id} was admitted. Personal content and retained evidence are not silently deleted.`);
  }

  if (dashboard.error) {
    return <RouteState tone="warning" title="Workspace unavailable" description="The selector may be stale or the workspace provider may be recovering." />;
  }
  if (!dashboard.data) {
    return <RouteState title="Loading workspace" description="Membership is being validated before trusted context is admitted." />;
  }

  return (
    <div>
      <PageHeader eyebrow="Trusted workspace context" title={dashboard.data.workspace.name} action={<div className="flex gap-2"><Badge tone="info">{dashboard.data.workspace.role}</Badge><Badge tone={dashboard.data.workspace.state === 'active' ? 'success' : 'danger'}>{dashboard.data.workspace.state}</Badge></div>} />
      {dashboard.data.workspace.state === 'suspended' ? <RouteState tone="warning" title="This workspace is suspended" description="Product mutations and workspace-scoped agent execution are disabled at admission. An application operator must restore the tenant before work can continue." /> : null}
      <div className="grid gap-5 lg:grid-cols-2"><Card aria-label="Members">
        <h2 className="text-lg font-semibold">People and roles</h2>
        <p className="mt-2 text-sm text-stone-600">Invite teammates and choose who can manage this workspace.</p>
        <div className="mt-4 space-y-3">{dashboard.data.members.map(member => (
          <div key={member.id} className="grid gap-2 rounded-xl border border-stone-200 p-3 sm:grid-cols-[1fr_12rem_auto] sm:items-center">
            <span className="min-w-0 truncate text-sm">{member.identityId}</span>
            {member.role === 'workspace-owner' ? <Badge>workspace-owner</Badge> : <Select value={member.role} onChange={event => void updateMembership({ identity: member.id, patch: { role: event.currentTarget.value as 'workspace-administrator' | 'workspace-member' } }).then(() => dashboard.refresh())}><option value="workspace-member">Member</option><option value="workspace-administrator">Administrator</option></Select>}
            {member.role === 'workspace-owner' ? null : <Button type="button" variant="ghost" disabled={deleteMembership.pending} onClick={() => void deleteMembership({ identity: member.id }).then(() => dashboard.refresh())}>Remove</Button>}
          </div>
        ))}</div>
      </Card>
      <Card aria-label="Invitations">
        <h2 className="text-lg font-semibold">Invitations</h2>
        {dashboard.data.invitations.map(invitation => (
          <fieldset
            key={invitation.id}
            aria-label={`Invitation ${invitation.email}`}
            className="my-3 rounded-xl border border-stone-200 p-3"
          >
            <div className="flex items-start justify-between gap-3"><p>{invitation.email} · {invitation.role}</p><Badge>{invitation.state}</Badge></div>
            <p className="mt-1 flex flex-wrap items-center gap-2 text-xs text-stone-600">
              Delivery
              <Badge
                tone={
                  invitation.deliveryState === 'delivered'
                    ? 'success'
                    : invitation.deliveryState === 'failed'
                    ? 'danger'
                    : 'warning'
                }
              >
                {invitation.deliveryState}
              </Badge>
              {invitation.deliveryProvider
                ? `${invitation.deliveryProvider} · ${invitation.deliveryAttempts} attempt${invitation.deliveryAttempts === 1 ? '' : 's'}`
                : 'Waiting for the configured application notification provider'}
            </p>
            {invitation.state === 'pending' ? <Button type="button" variant="ghost" className="mt-2" disabled={updateInvitation.pending} onClick={() => void updateInvitation({ identity: invitation.id, patch: { state: 'revoked' } }).then(() => dashboard.refresh())}>Revoke invitation</Button> : null}
          </fieldset>
        ))}
        <form onSubmit={invite}>
          <label htmlFor="invitation-email">Invite by email</label>
          <Input
            id="invitation-email"
            type="email"
            value={email}
            onChange={event => setEmail(event.currentTarget.value)}
          />
          <label className="mt-3 block" htmlFor="invitation-role">Role</label>
          <Select id="invitation-role" value={invitationRole} onChange={event => setInvitationRole(event.currentTarget.value as 'workspace-administrator' | 'workspace-member')}><option value="workspace-member">Member</option><option value="workspace-administrator">Administrator</option></Select>
          <Button
            type="submit"
            disabled={createInvitation.pending || !email.trim()}
          >
            Invite member
          </Button>
        </form>
        {notice ? (
          <p role="status">
            Single-use invitation: <a href={notice}>{notice}</a>
          </p>
        ) : null}
      </Card></div>
      {dashboard.data.workspace.role === 'workspace-owner' ? <Card className="mt-5 border-rose-200">
        <h2 className="text-lg font-semibold">Delete workspace</h2>
        <p className="mt-2 text-sm leading-6 text-stone-600">This asynchronous application request first requires paid billing to be cancelled, then deletes workspace-scoped mutable documents, archives active conversations, and removes membership. Immutable artifacts, provider records, receipts, and required audit evidence retain their declared lifecycle.</p>
        <label className="mt-4 block text-sm font-semibold" htmlFor="workspace-delete-confirmation">Type {dashboard.data.workspace.name} to continue</label>
        <Input id="workspace-delete-confirmation" className="mt-2" value={deleteConfirmation} onChange={event => setDeleteConfirmation(event.currentTarget.value)} />
        <Button className="mt-3" variant="danger" type="button" disabled={deleteConfirmation !== dashboard.data.workspace.name || requestLifecycle.pending} onClick={() => void requestWorkspaceDeletion()}>Request workspace deletion</Button>
      </Card> : null}
    </div>
  );
}
