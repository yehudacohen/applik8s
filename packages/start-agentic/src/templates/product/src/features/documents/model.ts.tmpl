import { AI } from '@applik8s/ai';
import { applicationCausalPrincipalContext, module } from '@applik8s/applik8s';
import { type } from 'arktype';
import { chat } from '@tanstack/ai';
import { and, desc, eq } from 'drizzle-orm';
import { application } from '../../app';
import { database, inference } from '../../providers';
import { Document as DocumentTable } from './schema';

const documents = module(
  'documents',
  DocumentTable,
  (application) => {
    const DocumentList = DocumentTable.view(
      {
        input: type({}),
        output: type({
          id: 'string',
          ownerPrincipalId: 'string',
          createdByPrincipalId: 'string',
          body: 'string',
          createdAt: 'string',
        }).array(),
        database,
        authorize: ({ principal }) => principal.id.length > 0,
      },
      async function listDocuments(_input, context) {
        return context.database(database)
          .select({
            id: DocumentTable.id,
            ownerPrincipalId: DocumentTable.ownerPrincipalId,
            createdByPrincipalId: DocumentTable.createdByPrincipalId,
            body: DocumentTable.body,
            createdAt: DocumentTable.createdAt,
          })
          .from(DocumentTable)
          .where(eq(DocumentTable.ownerPrincipalId, context.principal.id))
          .orderBy(desc(DocumentTable.createdAt))
          .limit(100);
      },
    );
    const DocumentDetail = DocumentTable.view(
      {
        input: type({ id: 'string' }),
        output: type({
          id: 'string',
          ownerPrincipalId: 'string',
          createdByPrincipalId: 'string',
          body: 'string',
          createdAt: 'string',
        }).or('null'),
        database,
        authorize: ({ principal }) => principal.id.length > 0,
      },
      async function loadDocument(input, context) {
        const [document] = await context.database(database)
          .select({
            id: DocumentTable.id,
            ownerPrincipalId: DocumentTable.ownerPrincipalId,
            createdByPrincipalId: DocumentTable.createdByPrincipalId,
            body: DocumentTable.body,
            createdAt: DocumentTable.createdAt,
          })
          .from(DocumentTable)
          .where(and(
            eq(DocumentTable.id, input.id),
            eq(DocumentTable.ownerPrincipalId, context.principal.id),
          ))
          .limit(1);
        return document ?? null;
      },
    );
    DocumentTable.create.beforeCommit({ history: true }, async (document, input, context) => {
      if (!context.principal) throw new Error('Document creation requires an admitted principal.');
      if (
        input.ownerPrincipalId !== undefined
        || input.createdByPrincipalId !== undefined
        || input.createdAt !== undefined
      ) throw new Error('Document ownership, provenance, and timestamps are server-owned.');
      const causal = applicationCausalPrincipalContext(context.principal);
      if (document.value.ownerPrincipalId !== causal.id) {
        throw new Error('The document owner must match the admitted causal principal.');
      }
      if (document.value.createdByPrincipalId !== context.principal.id) {
        throw new Error('Document creator provenance must match the acting principal.');
      }
    });
    DocumentTable.update.beforeCommit({ history: true }, async (document, input, context) => {
      if (!context.principal) throw new Error('Document updates require an admitted principal.');
      if (
        'id' in input.patch
        || 'ownerPrincipalId' in input.patch
        || 'createdByPrincipalId' in input.patch
        || 'createdAt' in input.patch
      ) throw new Error('Document identity, ownership, provenance, and timestamps are immutable.');
      if (document.value.ownerPrincipalId !== applicationCausalPrincipalContext(context.principal).id) {
        throw new Error('Only the document owner, or an admitted execution acting for that owner, may update it.');
      }
    });
    DocumentTable.delete.beforeCommit({ history: true }, async (document, _input, context) => {
      if (!context.principal) throw new Error('Document deletion requires an admitted principal.');
      if (document.value.ownerPrincipalId !== applicationCausalPrincipalContext(context.principal).id) {
        throw new Error('Only the document owner, or an admitted execution acting for that owner, may delete it.');
      }
    });
    const Authenticated = application.role('authenticated');
    const AssistantIdentity = application.serviceIdentity('workspace-assistant');
    const FastModel = AI.model('fast', {
      inference,
      capabilities: [AI.chat, AI.tools, AI.streaming],
    });
    const WorkspaceAssistant = application.agent(
      'workspace-assistant',
      {
        identity: AssistantIdentity,
        model: FastModel,
        instructions: 'Help the user create and refine useful workspace documents. Use the admitted document tools whenever the user asks you to create or update durable work.',
        tools: [DocumentTable.create, DocumentTable.update],
      },
      async (request, context) => chat({
        adapter: context.tanstack.adapter,
        messages: request.messages,
        threadId: request.threadId,
        runId: context.runId,
        tools: context.tanstack.tools,
        context: context.tanstack.execution,
      }),
    );

    Authenticated.can(DocumentTable.create, DocumentTable.update, DocumentTable.delete, DocumentList, DocumentDetail);
    AssistantIdentity.can(DocumentTable.create, DocumentTable.update);

    return {
      Document: DocumentTable,
      DocumentList,
      DocumentDetail,
      WorkspaceAssistant,
      Authenticated,
      AssistantIdentity,
    };
  },
);

export const {
  Document,
  DocumentList,
  DocumentDetail,
  WorkspaceAssistant,
  Authenticated,
  AssistantIdentity,
} = application.include(documents);
