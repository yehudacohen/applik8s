import {
  type FormEvent,
  useState,
} from 'react';
import { readAgenticWorkspaceSelection } from '@applik8s/start-agentic/react';
import {
  BillingDashboard,
  CancelSubscription,
  ChangeSubscription,
  OpenBillingPortal,
  ResumeSubscription,
  StartCheckout,
  WorkspaceBudgetPolicy,
} from '../application';
import { Badge, Button, Card, Checkbox, EmptyState, Input, PageHeader, RouteState, Skeleton } from '../components/ui';

export function BillingDashboardView() {
  const dashboard = BillingDashboard({}).useQuery();
  const subscription = dashboard.data?.subscription;
  const includedPlan = dashboard.data?.plans.find(plan => plan.priceMicrounits === 0);
  const activePlan = dashboard.data?.plans.find(plan => plan.id === subscription?.planId) ?? includedPlan;
  const [notice, setNotice] = useState<string>();
  const [failure, setFailure] = useState<string>();
  const [pending, setPending] = useState(false);
  const [providerSessionStarted, setProviderSessionStarted] = useState(false);

  async function choose(
    event: FormEvent<HTMLFormElement>,
    plan: string,
  ) {
    event.preventDefault();
    setFailure(undefined);
    setPending(true);
    try {
      const subscription = dashboard.data?.subscription;
      if (subscription) {
        const result = await ChangeSubscription({
          plan,
          intentId: crypto.randomUUID(),
          timing: 'immediate',
        });
        setNotice(
          result.state === 'scheduled'
            ? `Plan change scheduled for ${result.effectiveAt}.`
            : 'Plan changed.',
        );
        await dashboard.refresh();
      } else {
        const result = await StartCheckout({
          plan,
          intentId: crypto.randomUUID(),
          returnTo: globalThis.location.href,
        });
        setNotice(
          result.mode === 'simulated'
            ? 'Test checkout completed. No payment method was charged.'
            : 'Secure checkout created. Continuing to the payment provider.',
        );
        if (result.mode === 'simulated') setProviderSessionStarted(true);
        if (result.mode === 'live') globalThis.location.assign(result.url);
        else await dashboard.refresh();
      }
    } catch (error) {
      setFailure(actionFailure(error, 'Checkout could not be started.'));
    } finally {
      setPending(false);
    }
  }

  async function openPortal() {
    if (!dashboard.data?.subscription && !providerSessionStarted) return;
    setFailure(undefined);
    setPending(true);
    try {
      const result = await OpenBillingPortal({
        intentId: crypto.randomUUID(),
        returnTo: globalThis.location.href,
      });
      setNotice(
        result.mode === 'simulated'
          ? 'Test billing portal opened without changing a live account.'
          : 'Secure billing portal created. Continuing to the payment provider.',
      );
      if (result.mode === 'live') globalThis.location.assign(result.url);
    } catch (error) {
      setFailure(actionFailure(error, 'The billing portal is not available.'));
    } finally {
      setPending(false);
    }
  }

  async function cancel() {
    const subscription = dashboard.data?.subscription;
    if (!subscription) return;
    setFailure(undefined);
    setPending(true);
    try {
      const result = await CancelSubscription({
        intentId: crypto.randomUUID(),
        timing: 'periodEnd',
      });
      setNotice(`Cancellation scheduled for ${result.effectiveAt}.`);
      await dashboard.refresh();
    } catch (error) {
      setFailure(actionFailure(error, 'The subscription could not be cancelled.'));
    } finally {
      setPending(false);
    }
  }

  async function resume() {
    const subscription = dashboard.data?.subscription;
    if (!subscription) return;
    setFailure(undefined);
    setPending(true);
    try {
      await ResumeSubscription({ intentId: crypto.randomUUID() });
      setNotice('Subscription resumed.');
      await dashboard.refresh();
    } catch (error) {
      setFailure(actionFailure(error, 'The subscription could not be resumed.'));
    } finally {
      setPending(false);
    }
  }

  return (
    <div>
      <PageHeader eyebrow="Workspace billing" title="Plan, usage, and access" description="Choose a plan, understand this month’s usage, and manage payment details for your workspace." />
      {dashboard.phase === 'error' ? <RouteState tone="warning" title="Billing is temporarily unavailable" description="No billing change was made. Retry the workspace billing connection." action={<Button variant="secondary" onClick={() => void dashboard.refresh()}>Retry</Button>} /> : null}
      {!dashboard.data && dashboard.phase !== 'error' ? <Skeleton className="h-40" /> : null}
      <div className="grid gap-5 lg:grid-cols-2"><Card aria-label="Current plan">
        <h2 className="text-lg font-semibold">Current plan</h2>
        <p>
          {subscription
            ? `${activePlan?.name ?? 'Paid plan'} · ${humanizeBillingEvent(subscription.status)}`
            : includedPlan
              ? `${includedPlan.name} · included`
              : 'No plan configured'}
        </p>
        {subscription ? <dl className="mt-4 grid grid-cols-2 gap-2 text-sm"><dt className="text-stone-500">Provider</dt><dd>{subscription.provider}</dd><dt className="text-stone-500">Current period</dt><dd>through {new Date(subscription.periodEnd).toLocaleDateString()}</dd><dt className="text-stone-500">Renewal</dt><dd>{subscription.cancelAtPeriodEnd ? 'Ends at period close' : 'Renews automatically'}</dd>{subscription.scheduledChangeAt ? <><dt className="text-stone-500">Scheduled change</dt><dd>{new Date(subscription.scheduledChangeAt).toLocaleString()}</dd></> : null}</dl> : null}
        <div className="mt-4 flex flex-wrap gap-2">{(subscription || providerSessionStarted) && dashboard.data?.canManageBilling ? <Button variant="secondary" type="button" onClick={openPortal} disabled={pending}>
          Open billing portal
        </Button> : null}
        {dashboard.data?.canManageBilling && subscription?.status === 'cancelled' ? (
          <Button type="button" onClick={resume} disabled={pending}>
            Resume subscription
          </Button>
        ) : dashboard.data?.canManageBilling && subscription ? (
          <Button variant="ghost" type="button" onClick={cancel} disabled={pending}>
            Cancel at period end
          </Button>
        ) : null}</div>
      </Card>
      <Card aria-label="Usage"><h2 className="text-lg font-semibold">Usage this period</h2><p className="mt-3 text-2xl font-semibold">{(dashboard.data?.usage.inputTokens ?? 0).toLocaleString()} <span className="text-sm font-normal text-stone-500">input tokens</span></p><p className="mt-2 text-sm text-stone-600">{(dashboard.data?.usage.outputTokens ?? 0).toLocaleString()} output tokens · {formatMoney(dashboard.data?.usage.costMicrounits ?? 0, activePlan?.currency ?? 'usd')} estimated usage</p>{dashboard.data?.usage.reservedTokens ? <p className="mt-2 text-xs text-stone-500">{dashboard.data.usage.reservedTokens.toLocaleString()} tokens · {formatMoney(dashboard.data.usage.reservedCostMicrounits, activePlan?.currency ?? 'usd')} reserved by in-flight assistant runs</p> : null}</Card></div>
      <section className="mt-8" aria-label="Plans">
        <h2 className="text-xl font-semibold">Plans</h2>
        <div className="mt-3 grid gap-4 md:grid-cols-3">
        {dashboard.data?.plans.map(plan => {
          const current = subscription
            ? subscription.planId === plan.id
            : plan.priceMicrounits === 0;
          return <Card key={plan.id}><div className="flex h-full flex-col">
            <strong className="text-lg">{plan.name}</strong><p className="mt-1 text-2xl font-semibold">{plan.priceMicrounits === 0 ? 'Free' : formatMoney(plan.priceMicrounits, plan.currency)}<span className="text-sm font-normal text-stone-500"> / {plan.interval}</span></p>
            <p className="mt-2 flex-1 text-sm leading-6 text-stone-600">{plan.description}</p>
            {current ? <div className="mt-5"><Badge tone="success">Current plan</Badge></div>
              : plan.priceMicrounits === 0
                ? <p className="mt-5 text-xs text-stone-500">Becomes current after the paid subscription ends.</p>
                : dashboard.data?.canManageBilling
                  ? <form onSubmit={event => choose(event, plan.id)}><Button className="mt-5 w-full" type="submit" disabled={pending}>Choose {plan.name}</Button></form>
                  : <p className="mt-5 text-xs text-stone-500">A workspace owner or administrator manages plan changes.</p>}
          </div></Card>;
        })}
        </div>
        {dashboard.data?.plans.length === 0 ? <EmptyState title="No plans configured" description="An administrator can add plans from the product catalog." /> : null}
      </section>
      <Card className="mt-8" aria-label="Entitlements">
        <h2 className="text-lg font-semibold">Entitlements</h2>
        <div className="mt-3 flex flex-wrap gap-2">
        {dashboard.data?.entitlements.map(entitlement => (
          <Badge key={entitlement.capability} tone="info">{humanizeBillingEvent(entitlement.capability)} · {entitlement.limit ?? 'Unlimited'}</Badge>
        ))}
        {dashboard.data?.entitlements.length === 0 ? <p className="text-sm leading-6 text-stone-600">The included plan has no additional capability grants. Choose a paid plan to add workspace entitlements.</p> : null}
        </div>
      </Card>
      <Card className="mt-5" aria-label="Billing history">
        <div className="flex items-center justify-between gap-3"><h2 className="text-lg font-semibold">Billing history</h2><span className="text-xs text-stone-500">Latest activity</span></div>
        {dashboard.data?.history.length ? <div className="mt-3 divide-y divide-stone-100">{dashboard.data.history.map(event => <div key={event.id} className="flex items-center justify-between gap-4 py-3 text-sm"><div><strong className="block">{humanizeBillingEvent(event.type)}</strong><span className="text-xs text-stone-500">{event.provider}</span></div><time className="text-xs text-stone-500">{new Date(event.occurredAt).toLocaleString()}</time></div>)}</div> : <p className="mt-3 text-sm leading-6 text-stone-600">No provider event has been reconciled for this workspace yet. Receipts and invoices remain available in the provider portal when the active provider supports it.</p>}
      </Card>
      {failure ? <p role="alert" className="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">{failure}</p> : null}
      {notice ? <p role="status" className="mt-4 text-sm text-stone-600">{notice}</p> : null}
    </div>
  );
}

function humanizeBillingEvent(value: string) {
  return value.replace(/[._-]+/gu, ' ').replace(/\b\w/gu, character => character.toUpperCase());
}

function formatMoney(microunits: number, currency: string) {
  return new Intl.NumberFormat(undefined, {
    style: 'currency',
    currency: currency.toUpperCase(),
    maximumFractionDigits: 2,
  }).format(microunits / 1_000_000);
}

function actionFailure(error: unknown, fallback: string): string {
  if (error instanceof Error && error.message.trim()) {
    return `${fallback} ${error.message}`;
  }
  return fallback;
}

export function UsageDashboardView() {
  const dashboard = BillingDashboard({}).useQuery();
  const selectedWorkspaceId = readAgenticWorkspaceSelection();
  const createBudget = WorkspaceBudgetPolicy.create.useMutation();
  const updateBudget = WorkspaceBudgetPolicy.update.useMutation();
  const [tokenLimit, setTokenLimit] = useState('');
  const [costLimit, setCostLimit] = useState('');
  const [threshold, setThreshold] = useState('80');
  const [hardLimit, setHardLimit] = useState(true);
  const [notice, setNotice] = useState<string>();
  const input = dashboard.data?.usage.inputTokens ?? 0;
  const output = dashboard.data?.usage.outputTokens ?? 0;
  const total = input + output;
  const inputShare = total > 0 ? Math.round(input / total * 100) : 0;
  async function saveBudget(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!selectedWorkspaceId) {
      setNotice('Select a workspace before configuring a shared budget.');
      return;
    }
    const policy = {
      maxMonthlyTokens: tokenLimit.trim() ? Number(tokenLimit) : null,
      maxMonthlyCostMicrounits: costLimit.trim() ? Number(costLimit) : null,
      alertThresholdPercent: Number(threshold),
      hardLimit,
    };
    try {
      if (dashboard.data?.budget) {
        await updateBudget({ identity: selectedWorkspaceId, patch: policy });
      } else {
        await createBudget({ workspaceId: selectedWorkspaceId, ...policy });
      }
      await dashboard.refresh();
      setNotice('Workspace budget saved. New assistant runs will respect this limit.');
    } catch (error) {
      setNotice(error instanceof Error ? error.message : 'The workspace budget could not be saved.');
    }
  }
  return <div>
    <PageHeader eyebrow="Workspace activity" title="Usage" description="Track assistant activity, understand token consumption, and set a budget before costs surprise your team." />
    {!dashboard.data ? <div className="grid gap-4 sm:grid-cols-3"><Skeleton className="h-32" /><Skeleton className="h-32" /><Skeleton className="h-32" /></div> : null}
    {dashboard.data ? <>
      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><Metric label="Input tokens" value={input.toLocaleString()} /><Metric label="Output tokens" value={output.toLocaleString()} /><Metric label="Estimated cost" value={formatMoney(dashboard.data.usage.costMicrounits, dashboard.data.plans[0]?.currency ?? 'usd')} /><Metric label="In-flight reservation" value={dashboard.data.usage.reservedTokens ? `${dashboard.data.usage.reservedTokens.toLocaleString()} tokens` : 'None'} /></div>
      <Card className="mt-5"><div className="flex items-center justify-between gap-4"><div><h2 className="font-semibold">Token mix</h2><p className="mt-1 text-sm text-stone-600">Current calendar month</p></div><Badge tone="info">{inputShare}% input</Badge></div><div role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={inputShare} className="mt-5 h-3 overflow-hidden rounded-full bg-stone-100" aria-label={`${inputShare}% input tokens`}><div className="h-full bg-emerald-700" style={{ width: `${inputShare}%` }} /></div><p className="mt-4 text-xs text-stone-500">Usage can update shortly after an assistant run finishes.</p></Card>
      <Card className="mt-5"><div className="flex flex-wrap items-start justify-between gap-3"><div><h2 className="font-semibold">Workspace AI budget</h2><p className="mt-1 text-sm text-stone-600">Application-owned limits are evaluated before inference; provider billing remains downstream evidence.</p></div><Badge tone={dashboard.data.budget?.hardLimit ? 'warning' : 'info'}>{dashboard.data.budget?.hardLimit ? 'Hard limit' : 'Alert only'}</Badge></div><form className="mt-4 grid gap-4 sm:grid-cols-2" onSubmit={saveBudget}><label className="text-sm font-medium">Monthly tokens<Input className="mt-2" inputMode="numeric" value={tokenLimit} placeholder={String(dashboard.data.budget?.maxMonthlyTokens ?? '')} onChange={event => setTokenLimit(event.currentTarget.value)} /></label><label className="text-sm font-medium">Monthly budget (USD)<Input className="mt-2" inputMode="decimal" value={costLimit ? String(Number(costLimit) / 1_000_000) : ''} placeholder={dashboard.data.budget?.maxMonthlyCostMicrounits ? String(dashboard.data.budget.maxMonthlyCostMicrounits / 1_000_000) : ''} onChange={event => setCostLimit(event.currentTarget.value ? String(Math.round(Number(event.currentTarget.value) * 1_000_000)) : '')} /></label><label className="text-sm font-medium">Alert threshold (%)<Input className="mt-2" inputMode="numeric" value={threshold} onChange={event => setThreshold(event.currentTarget.value)} /></label><label className="flex items-center gap-3 self-end pb-3 text-sm font-medium"><Checkbox checked={hardLimit} onCheckedChange={checked => setHardLimit(checked === true)} /> Stop new AI runs at the limit</label><Button type="submit" disabled={createBudget.pending || updateBudget.pending || !selectedWorkspaceId}>Save budget</Button></form>{!selectedWorkspaceId ? <p className="mt-3 text-xs text-amber-800">Choose a workspace from Workspaces to manage its shared budget.</p> : null}{notice ? <p role="status" className="mt-3 text-sm text-stone-600">{notice}</p> : null}</Card>
      {total === 0 ? <div className="mt-5"><EmptyState title="No usage yet" description="Run the assistant once and this dashboard will begin tracking activity." /></div> : null}
    </> : null}
  </div>;
}

function Metric({ label, value }: { readonly label: string; readonly value: string }) {
  return <Card><p className="text-sm text-stone-500">{label}</p><p className="mt-2 text-2xl font-semibold tracking-tight">{value}</p></Card>;
}
