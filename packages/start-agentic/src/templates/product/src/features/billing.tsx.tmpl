const BillingDashboardResult = type({
  canManageBilling: 'boolean',
  plans: type({
    id: 'string',
    name: 'string',
    description: 'string',
    interval: 'string',
    priceMicrounits: 'number',
    currency: 'string',
  }).array(),
  subscription: type({
    planId: 'string',
    provider: 'string',
    status: "'trialing' | 'active' | 'past_due' | 'paused' | 'unpaid' | 'cancelled' | 'incomplete'",
    periodEnd: 'string',
    cancelAtPeriodEnd: 'boolean',
    'scheduledChangeAt?': 'string',
  }).or('null'),
  usage: {
    inputTokens: 'number',
    outputTokens: 'number',
    costMicrounits: 'number',
    reservedTokens: 'number',
    reservedCostMicrounits: 'number',
    unpricedFacts: 'number.integer >= 0',
    providerActivity: type({
      logicalRole: 'string',
      provider: 'string',
      backend: 'string',
      calls: 'number.integer >= 0',
      inputTokens: 'number.integer >= 0',
      outputTokens: 'number.integer >= 0',
      costMicrounits: 'number',
      pricing: "'priced' | 'unpriced'",
      confidence: 'string',
    }).array(),
  },
  budget: type({
    'maxMonthlyTokens?': 'number | null',
    'maxMonthlyCostMicrounits?': 'number | null',
    alertThresholdPercent: 'number',
    hardLimit: 'boolean',
  }).or('null'),
  entitlements: type({
    capability: 'string',
    'limit?': 'number | null',
    'period?': 'string | null',
    validFrom: 'string',
    'validUntil?': 'string | null',
  }).array(),
  history: type({
    id: 'string',
    provider: 'string',
    type: 'string',
    occurredAt: 'string',
  }).array(),
});

async function loadBillingDashboard(
  _input: object,
  context: ApplicationModelViewContext,
) {
  const client = context.database(database);
  const principalScope = agenticWorkspaceScope(context);
  const workspaceId = selectedAgenticWorkspaceId(context);
  const periodStart = `${new Date().toISOString().slice(0, 7)}-01T00:00:00.000Z`;
  const [plans, subscriptions, usageRows, usageFacts, budgetRows, ledgerRows, entitlements, history] = await Promise.all([
    client.select({
      id: Billing.BillingPlan.id,
      name: Billing.BillingPlan.name,
      description: Billing.BillingPlan.description,
      interval: Billing.BillingPlan.interval,
      priceMicrounits: Billing.BillingPlan.priceMicrounits,
      currency: Billing.BillingPlan.currency,
    })
      .from(Billing.BillingPlan)
      .where(eq(Billing.BillingPlan.active, true))
      .limit(25),
    client.select({
      planId: Billing.Subscription.planId,
      provider: Billing.Subscription.provider,
      status: Billing.Subscription.status,
      periodEnd: Billing.Subscription.periodEnd,
      cancelAtPeriodEnd: Billing.Subscription.cancelAtPeriodEnd,
      scheduledChangeAt: Billing.Subscription.scheduledChangeAt,
    })
      .from(Billing.Subscription)
      .where(eq(Billing.Subscription.principalScope, principalScope))
      .orderBy(desc(Billing.Subscription.updatedAt))
      .limit(1),
    client.select({
      inputTokens: sql<number>`coalesce(sum(${Usage.UsageFact.inputTokens}), 0)`,
      outputTokens: sql<number>`coalesce(sum(${Usage.UsageFact.outputTokens}), 0)`,
      costMicrounits: sql<number>`coalesce(sum(${Usage.UsageFact.costMicrounits}), 0)`,
    })
      .from(Usage.UsageFact)
      .where(and(
        eq(Usage.UsageFact.principalScope, principalScope),
        gte(Usage.UsageFact.occurredAt, periodStart),
      )),
    client.select({
      logicalModel: Usage.UsageFact.logicalModel,
      operationId: Usage.UsageFact.operationId,
      provider: Usage.UsageFact.provider,
      backend: Usage.UsageFact.backend,
      inputTokens: Usage.UsageFact.inputTokens,
      outputTokens: Usage.UsageFact.outputTokens,
      costMicrounits: Usage.UsageFact.costMicrounits,
      pricingRevision: Usage.UsageFact.pricingRevision,
      confidence: Usage.UsageFact.confidence,
    })
      .from(Usage.UsageFact)
      .where(and(
        eq(Usage.UsageFact.principalScope, principalScope),
        gte(Usage.UsageFact.occurredAt, periodStart),
      ))
      .orderBy(desc(Usage.UsageFact.occurredAt))
      .limit(250),
    workspaceId ? client.select({
      maxMonthlyTokens: WorkspaceBudgetPolicy.maxMonthlyTokens,
      maxMonthlyCostMicrounits: WorkspaceBudgetPolicy.maxMonthlyCostMicrounits,
      alertThresholdPercent: WorkspaceBudgetPolicy.alertThresholdPercent,
      hardLimit: WorkspaceBudgetPolicy.hardLimit,
    }).from(WorkspaceBudgetPolicy)
      .where(eq(WorkspaceBudgetPolicy.workspaceId, workspaceId))
      .limit(1) : Promise.resolve([]),
    workspaceId ? client.select({
      reservedTokens: AIUsageBudgetLedger.reservedTokens,
      reservedCostMicrounits: AIUsageBudgetLedger.reservedCostMicrounits,
    }).from(AIUsageBudgetLedger)
      .where(and(
        eq(AIUsageBudgetLedger.workspaceId, workspaceId),
        eq(AIUsageBudgetLedger.periodStart, periodStart),
      ))
      .limit(1) : Promise.resolve([]),
    client.select({
      capability: Usage.Entitlement.capability,
      limit: Usage.Entitlement.limit,
      period: Usage.Entitlement.period,
      validFrom: Usage.Entitlement.validFrom,
      validUntil: Usage.Entitlement.validUntil,
    })
      .from(Usage.Entitlement)
      .where(eq(Usage.Entitlement.principalScope, principalScope))
      .limit(100),
    client.select({
      id: Billing.PaymentEvent.id,
      provider: Billing.PaymentEvent.provider,
      type: Billing.PaymentEvent.type,
      occurredAt: Billing.PaymentEvent.occurredAt,
    })
      .from(Billing.PaymentEvent)
      .where(eq(Billing.PaymentEvent.principalScope, principalScope))
      .orderBy(desc(Billing.PaymentEvent.occurredAt))
      .limit(25),
  ]);
  const usage = usageRows[0];
  const budget = budgetRows[0];
  const ledger = ledgerRows[0];
  const subscription = subscriptions[0];
  const activity = new Map<string, {
    logicalRole: string;
    provider: string;
    backend: string;
    calls: number;
    inputTokens: number;
    outputTokens: number;
    costMicrounits: number;
    pricing: 'priced' | 'unpriced';
    confidence: string;
  }>();
  for (const fact of usageFacts) {
    const logicalRole = fact.logicalModel ?? fact.operationId ?? 'unclassified';
    const provider = fact.provider ?? 'unreported';
    const backend = fact.backend ?? 'unreported';
    const key = `${logicalRole}\0${provider}\0${backend}`;
    const current = activity.get(key) ?? {
      logicalRole,
      provider,
      backend,
      calls: 0,
      inputTokens: 0,
      outputTokens: 0,
      costMicrounits: 0,
      pricing: 'priced' as const,
      confidence: fact.confidence,
    };
    current.calls += 1;
    current.inputTokens += Number(fact.inputTokens ?? 0);
    current.outputTokens += Number(fact.outputTokens ?? 0);
    current.costMicrounits += Number(fact.costMicrounits ?? 0);
    if (!fact.pricingRevision) current.pricing = 'unpriced';
    if (current.confidence !== fact.confidence) current.confidence = 'mixed';
    activity.set(key, current);
  }
  return {
    canManageBilling: canManageWorkspaceBilling(context),
    plans,
    subscription: subscription ? {
      planId: subscription.planId,
      provider: subscription.provider,
      status: subscription.status,
      periodEnd: subscription.periodEnd,
      cancelAtPeriodEnd: subscription.cancelAtPeriodEnd,
      ...(subscription.scheduledChangeAt
        ? { scheduledChangeAt: subscription.scheduledChangeAt }
        : {}),
    } : null,
    usage: {
      inputTokens: Number(usage?.inputTokens ?? 0),
      outputTokens: Number(usage?.outputTokens ?? 0),
      costMicrounits: Number(usage?.costMicrounits ?? 0),
      reservedTokens: Number(ledger?.reservedTokens ?? 0),
      reservedCostMicrounits: Number(ledger?.reservedCostMicrounits ?? 0),
      unpricedFacts: usageFacts.filter(fact => !fact.pricingRevision).length,
      providerActivity: [...activity.values()].sort((left, right) =>
        right.costMicrounits - left.costMicrounits
        || right.inputTokens + right.outputTokens - left.inputTokens - left.outputTokens),
    },
    budget: budget ? {
      maxMonthlyTokens: budget.maxMonthlyTokens,
      maxMonthlyCostMicrounits: budget.maxMonthlyCostMicrounits,
      alertThresholdPercent: budget.alertThresholdPercent,
      hardLimit: budget.hardLimit,
    } : null,
    entitlements,
    history,
  };
}

export const BillingDashboard = Billing.BillingPlan.view(
  {
    input: type({}),
    output: BillingDashboardResult,
    database,
    reads: [
      Billing.Subscription,
      Billing.PaymentEvent,
      Usage.UsageFact,
      Usage.Entitlement,
      WorkspaceBudgetPolicy,
      AIUsageBudgetLedger,
    ],
    authorize: ({ principal }) => principal.id.length > 0,
    budgets: {
      timeoutMs: 2_000,
      maxRows: 250,
      maxResultBytes: 256_000,
    },
  },
  loadBillingDashboard,
);

/** The application catalog is authoritative for every provider-facing plan. */
export async function requirePublishedBillingPlan(id: string) {
  const [snapshot] = await applicationBillingPlans.find({
    where: { id, active: true },
    limit: 1,
  });
  if (!snapshot?.value.active) {
    throw new Error(`Billing plan ${JSON.stringify(id)} is not active in the application catalog.`);
  }
  return snapshot.value;
}

/**
 * The assistant reserves its worst-case provider charge atomically before
 * dispatch. The model hook owns workspace scope, policy checks, and the
 * monthly ledger; callers cannot accidentally recreate a read/check race.
 */
export const ReserveWorkspaceAIRun = AIUsageReservation.create;

async function loadStarterSubscription(
  principalScope: string,
) {
  const [subscription] = await Billing.Subscription.find({
    where: { principalScope },
    limit: 1,
  });
  return subscription?.value ?? null;
}

const billingApi = application.http('billing');

// Subscription state is reachable only through the billing intent routes and
// the maintained payment-event projection. The enclosing route policy is the
// application decision; raw model writes are never granted to a browser role.
Billing.Subscription.create.applicationPolicy();
Billing.Subscription.update.applicationPolicy();

export const ReceivePaymentWebhook = billingApi.webhook(
  'receive-payment-webhook',
  '/webhooks/payments',
  {
    event: PaymentEvent,
    output: PaymentWebhookResult,
    authenticate: request => Billing.verifyWebhook({
      body: request.body,
      headers: request.headers,
    }),
  },
  async function receivePaymentWebhook(request) {
    const event = request.input;
    await requirePublishedBillingPlan(event.plan);
    await Billing.PaymentEvent.create({
      id: event.id,
      provider: event.provider,
      providerEventId: event.id,
      principalScope: event.principalScope,
      providerSubscriptionId: event.subscriptionId,
      type: event.rawType,
      occurredAt: event.occurredAt,
      payload: event,
    });
    return { received: true, eventId: event.id };
  },
);

export const StartCheckout = billingApi.post(
  'start-checkout',
  '/checkout',
  {
    input: CheckoutInput,
    output: CheckoutOutput,
    authorize: (_request, context) => canManageWorkspaceBilling(context),
  },
  async function startCheckout(request, context) {
    const principalScope = agenticWorkspaceScope(context);
    const plan = await requirePublishedBillingPlan(request.input.plan);
    const returnTo = trustedBillingReturnUrl(
      request.input.returnTo,
      context.requestOrigin,
    );
    const result = await Billing.startCheckout({
      principalScope,
      plan: plan.id,
      returnTo,
      idempotencyKey: `${principalScope}:checkout:${request.input.intentId}`,
    });
    if (result.mode === 'simulated') {
      const now = new Date();
      const periodEnd = new Date(now);
      periodEnd.setUTCMonth(periodEnd.getUTCMonth() + 1);
      const current = await loadStarterSubscription(principalScope);
      const providerCustomerId = result.providerCustomerId ?? `starter-customer:${principalScope}`;
      if (current) {
        await Billing.Subscription.update({
          identity: current.id,
          patch: {
            planId: plan.id,
            provider: result.provider,
            providerCustomerId,
            status: 'active',
            cancelAtPeriodEnd: false,
            scheduledChangeAt: null,
            periodStart: now.toISOString(),
            periodEnd: periodEnd.toISOString(),
            providerOccurredAt: now.toISOString(),
            updatedAt: now.toISOString(),
          },
        });
      } else {
        await Billing.Subscription.create({
          id: `starter-subscription:${principalScope}`,
          principalScope,
          planId: plan.id,
          provider: result.provider,
          providerCustomerId,
          providerSubscriptionId: `starter-subscription:${principalScope}`,
          status: 'active',
          cancelAtPeriodEnd: false,
          periodStart: now.toISOString(),
          periodEnd: periodEnd.toISOString(),
          providerOccurredAt: now.toISOString(),
          updatedAt: now.toISOString(),
        });
      }
      await Billing.PaymentEvent.create({
        id: `starter-checkout:${request.input.intentId}`,
        provider: result.provider,
        providerEventId: result.providerCheckoutId,
        principalScope,
        providerSubscriptionId: current?.providerSubscriptionId ?? `starter-subscription:${principalScope}`,
        type: 'checkout.completed',
        occurredAt: now.toISOString(),
        payload: {
          provider: result.provider,
          id: result.providerCheckoutId,
          customerId: providerCustomerId,
          subscriptionId: current?.providerSubscriptionId ?? `starter-subscription:${principalScope}`,
          principalScope,
          plan: plan.id,
          status: 'active',
          occurredAt: now.toISOString(),
          periodStart: now.toISOString(),
          periodEnd: periodEnd.toISOString(),
          rawType: 'checkout.completed',
        },
      });
    }
    return result;
  },
);

export const OpenBillingPortal = billingApi.post(
  'open-portal',
  '/portal',
  {
    input: PortalInput,
    output: PortalOutput,
    authorize: (_request, context) => canManageWorkspaceBilling(context),
  },
  async function openBillingPortal(request, context) {
    const principalScope = agenticWorkspaceScope(context);
    const returnTo = trustedBillingReturnUrl(
      request.input.returnTo,
      context.requestOrigin,
    );
    return Billing.openBillingPortal({
      principalScope,
      returnTo,
      idempotencyKey: `${principalScope}:portal:${request.input.intentId}`,
    });
  },
);

export const ChangeSubscription = billingApi.post(
  'change-subscription',
  '/subscription/change',
  {
    input: ChangeSubscriptionInput,
    output: ChangeSubscriptionOutput,
    authorize: (_request, context) => canManageWorkspaceBilling(context),
  },
  async function changeSubscription(request, context) {
    const principalScope = agenticWorkspaceScope(context);
    const plan = await requirePublishedBillingPlan(request.input.plan);
    const result = await Billing.changeSubscription({
      principalScope,
      plan: plan.id,
      timing: request.input.timing,
      proration: 'createProrations',
      idempotencyKey:
        `${principalScope}:change:${request.input.intentId}`,
    });
    const current = await loadStarterSubscription(principalScope);
    if (current && result.provider === 'local') {
      await Billing.Subscription.update({
        identity: current.id,
        patch: {
          planId: plan.id,
          ...(result.state === 'scheduled'
            ? { scheduledChangeAt: result.effectiveAt }
            : { scheduledChangeAt: null }),
          updatedAt: new Date().toISOString(),
        },
      });
    }
    return result;
  },
);

export const CancelSubscription = billingApi.post(
  'cancel-subscription',
  '/subscription/cancel',
  {
    input: CancelSubscriptionInput,
    output: CancelSubscriptionOutput,
    authorize: (_request, context) => canManageWorkspaceBilling(context),
  },
  async function cancelSubscription(request, context) {
    const principalScope = agenticWorkspaceScope(context);
    const result = await Billing.cancelSubscription({
      principalScope,
      timing: request.input.timing,
      idempotencyKey:
        `${principalScope}:cancel:${request.input.intentId}`,
    });
    const current = await loadStarterSubscription(principalScope);
    if (current && result.provider === 'local') {
      await Billing.Subscription.update({
        identity: current.id,
        patch: {
          cancelAtPeriodEnd: request.input.timing === 'periodEnd',
          status: request.input.timing === 'immediate' ? 'cancelled' : 'active',
          updatedAt: new Date().toISOString(),
        },
      });
    }
    return result;
  },
);

export const ResumeSubscription = billingApi.post(
  'resume-subscription',
  '/subscription/resume',
  {
    input: ResumeSubscriptionInput,
    output: CancelSubscriptionOutput,
    authorize: (_request, context) => canManageWorkspaceBilling(context),
  },
  async function resumeSubscription(_request, context) {
    const principalScope = agenticWorkspaceScope(context);
    const result = await Billing.resumeSubscription({
      principalScope,
      idempotencyKey:
        `${principalScope}:resume:${_request.input.intentId}`,
    });
    const current = await loadStarterSubscription(principalScope);
    if (current && result.provider === 'local') {
      await Billing.Subscription.update({
        identity: current.id,
        patch: {
          status: 'active',
          cancelAtPeriodEnd: false,
          scheduledChangeAt: null,
          updatedAt: new Date().toISOString(),
        },
      });
    }
    return result;
  },
);
