import { Link } from '@tanstack/react-router';
import { useEffect, useMemo, useRef, useState } from 'react';
import { OnboardingProgress, OnboardingState } from '../../application';
import { Alert, Button, Card, Progress } from '../../components/ui';

export const productJourneySteps = [
  { id: 'first-document', label: 'Create useful work with the assistant', to: '/app' },
  { id: 'edit-document', label: 'Refine it as a new document revision', to: '/app/documents' },
  { id: 'request-review', label: 'Request a durable review', to: '/app/documents' },
  { id: 'publish-document', label: 'Approve and publish the result', to: '/app/inbox' },
] as const;

export type ProductJourneyStepId = typeof productJourneySteps[number]['id'];

export function ProductJourney({ documents }: { readonly documents: readonly { readonly version: number; readonly state: string }[] }) {
  const state = OnboardingState({}).useQuery();
  const create = OnboardingProgress.create.useMutation();
  const update = OnboardingProgress.update.useMutation();
  const [notice, setNotice] = useState<string>();
  const recording = useRef<ReadonlySet<string>>(new Set());
  const completed = useMemo(() => {
    const steps = new Set(state.data?.completedSteps ?? []);
    if (documents.length > 0) steps.add('first-document');
    if (documents.some(document => document.version > 1)) steps.add('edit-document');
    if (documents.some(document => ['in-review', 'approved', 'published'].includes(document.state))) steps.add('request-review');
    if (documents.some(document => document.state === 'published')) steps.add('publish-document');
    return steps;
  }, [documents, state.data?.completedSteps]);
  const percent = completed.size / productJourneySteps.length * 100;

  useEffect(() => {
    const achieved = productJourneySteps.map(step => step.id).filter(step => completed.has(step));
    const missing = achieved.filter(step => !state.data?.completedSteps.includes(step));
    if (missing.length === 0 || state.data === undefined || missing.some(step => recording.current.has(step))) return;
    recording.current = new Set([...recording.current, ...missing]);
    const completedSteps = [...new Set([...(state.data?.completedSteps ?? []), ...achieved])];
    const progress = { completedSteps, dismissed: state.data?.dismissed ?? false };
    const save = state.data
      ? update({ identity: state.data.principalId, patch: progress })
      : create(progress);
    void save
      .then(() => state.refresh())
      .catch(() => {
        recording.current = new Set([...recording.current].filter(step => !missing.includes(step as ProductJourneyStepId)));
        setNotice('Progress could not be saved. The product remains available.');
      });
  }, [completed, create, state.data, state.refresh, update]);

  if (state.data?.dismissed || state.data?.completedAt) return null;

  async function persist(dismissed = false) {
    const completedSteps = [...completed];
    const progress = { completedSteps, dismissed };
    try {
      if (state.data) {
        await update({
          identity: state.data.principalId,
          patch: progress,
        });
      } else {
        await create(progress);
      }
      await state.refresh();
    } catch {
      setNotice('Progress could not be saved. The product remains available.');
    }
  }

  const next = productJourneySteps.find(step => !completed.has(step.id));
  return (
    <Card surface="unstyled" className="mb-6 overflow-hidden border-emerald-900/10 bg-gradient-to-br from-emerald-950 to-emerald-800 text-white">
      <div className="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div className="max-w-2xl">
          <p className="eyebrow !text-emerald-300">Your app is running</p>
          <h2 className="mt-2 text-2xl font-semibold tracking-tight">Make the first useful loop visible.</h2>
          <p className="mt-2 text-sm leading-6 text-emerald-100/80">Ask the assistant for a useful first draft, refine it in Documents, and publish it when it is ready.</p>
        </div>
        <span className="text-sm font-semibold text-emerald-100">{completed.size} of {productJourneySteps.length}</span>
      </div>
      <div className="mt-5 [&_span]:text-emerald-100 [&_[role=progressbar]]:bg-white/15 [&_[role=progressbar]>div]:bg-emerald-300">
        <Progress value={percent} label="Product activation" />
      </div>
      <div className="mt-5 flex flex-wrap gap-3">
        {next ? <Button asChild variant="secondary" className="border-white bg-white text-emerald-950 hover:bg-emerald-50"><Link to={next.to}>{next.label}</Link></Button> : null}
        <Button type="button" variant="ghost" className="text-emerald-50 hover:bg-white/10" onClick={() => void persist(true)}>Dismiss tour</Button>
      </div>
      {notice ? <div className="mt-4"><Alert tone="warning" title="Progress unavailable">{notice}</Alert></div> : null}
    </Card>
  );
}
