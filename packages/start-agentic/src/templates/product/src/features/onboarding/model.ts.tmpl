import { module } from '@applik8s/applik8s';
import { type } from 'arktype';
import { eq } from 'drizzle-orm';
import { application } from '../../app';
import { database } from '../../providers';
import { Authenticated } from '../workspaces/model';
import { OnboardingProgress as OnboardingProgressTable } from './schema';

const onboarding = module('onboarding', OnboardingProgressTable, () => {
  OnboardingProgressTable.create.beforeCommit(
    { history: true },
    async function establishOnboardingIdentity(progress, input, context) {
      if (!context.principal) {
        throw new Error('Onboarding progress requires an authenticated identity.');
      }
      if (
        input.principalId !== undefined
        || input.completedAt !== undefined
        || input.updatedAt !== undefined
      ) {
        throw new Error('Onboarding identity and timestamps are server-owned.');
      }
      progress.patch({
        spec: {
          principalId: context.principal.id,
          updatedAt: context.now,
          completedAt: (input.completedSteps?.length ?? 0) >= 4 ? context.now : null,
        },
      });
    },
  );
  OnboardingProgressTable.update.beforeCommit(
    { history: true },
    async function protectOnboardingIdentity(progress, input, context) {
      if (!context.principal || progress.value.principalId !== context.principal.id) {
        throw new Error('Onboarding progress is outside the authenticated identity.');
      }
      if ('principalId' in input.patch || 'completedAt' in input.patch || 'updatedAt' in input.patch) {
        throw new Error('Onboarding identity and timestamps are server-owned.');
      }
      progress.patch({
        spec: {
          updatedAt: context.now,
          ...('completedSteps' in input.patch
            ? { completedAt: (input.patch.completedSteps?.length ?? 0) >= 4 ? context.now : null }
            : {}),
        },
      });
    },
  );
  const OnboardingState = OnboardingProgressTable.view({
    input: type({}),
    output: type({
      principalId: 'string',
      completedSteps: 'string[]',
      dismissed: 'boolean',
      'completedAt?': 'string',
    }).or('null'),
    database,
    authorize: ({ principal }) => principal.id.length > 0,
  }, async function loadOnboardingState(_input, context) {
    const [row] = await context.database(database).select({
      principalId: OnboardingProgressTable.principalId,
      completedSteps: OnboardingProgressTable.completedSteps,
      dismissed: OnboardingProgressTable.dismissed,
      completedAt: OnboardingProgressTable.completedAt,
    }).from(OnboardingProgressTable).where(eq(
      OnboardingProgressTable.principalId,
      context.principal.id,
    )).limit(1);
    return row
      ? { principalId: row.principalId, completedSteps: row.completedSteps, dismissed: row.dismissed, ...(row.completedAt ? { completedAt: row.completedAt } : {}) }
      : null;
  });

  Authenticated.can(
    OnboardingProgressTable.create,
    OnboardingProgressTable.update,
    OnboardingState,
  );
  return { OnboardingProgress: OnboardingProgressTable, OnboardingState };
});

export const { OnboardingProgress, OnboardingState } = application.include(onboarding);
