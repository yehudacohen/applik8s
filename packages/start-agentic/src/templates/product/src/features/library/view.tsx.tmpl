import { Link } from '@tanstack/react-router';
import { WorkspaceLibrary } from '../../application';
import { Badge, Button, Card, EmptyState, PageHeader, RouteState, Skeleton } from '../../components/ui';

export function ArtifactsView() {
  const library = WorkspaceLibrary({}).useQuery();
  return (
    <div>
      <PageHeader
        eyebrow="Published work"
        title="Artifacts"
        description="Immutable published files and generated outputs remain distinct from editable Documents, with a digest, provenance, and bounded download authority."
        action={library.phase === 'reconnecting'
          ? <Badge tone="warning">Reconnecting…</Badge>
          : library.data ? <Badge tone="success">Up to date</Badge> : null}
      />
      {library.phase === 'error' ? (
        <RouteState
          tone="warning"
          title="Artifacts are temporarily unavailable"
          description="Your work is safe. Try loading published outputs again."
          action={<Button variant="secondary" onClick={() => void library.refresh()}>Retry artifacts</Button>}
        />
      ) : null}
      {library.data === undefined && library.phase !== 'error' ? (
        <div role="status" aria-label="Loading artifacts" className="grid gap-4 sm:grid-cols-2">
          <Skeleton className="h-40" />
          <Skeleton className="h-40" />
        </div>
      ) : null}
      {library.data ? (
        <div>
          <section aria-labelledby="artifacts-title">
            <div className="mb-3 flex items-center gap-3">
              <h2 id="artifacts-title" className="text-xl font-semibold">Artifacts</h2>
              <Badge>{library.data.artifacts.length}</Badge>
            </div>
            {library.data.artifacts.length === 0 ? (
              <EmptyState
                title="No immutable artifacts yet"
                description="Publish a Document to preserve an immutable Markdown output with its source and revision history."
                action={<Button asChild><Link to="/app/documents">Open Documents</Link></Button>}
              />
            ) : (
              <div className="grid gap-4">
                {library.data.artifacts.map(artifact => (
                  <Link key={artifact.id} to="/app/artifacts/$artifactId" params={{ artifactId: artifact.id }} className="text-stone-950 no-underline">
                    <Card className="h-full transition hover:border-emerald-300">
                      <div className="flex items-center justify-between"><Badge tone="success">Immutable artifact</Badge><Badge tone={artifact.state === 'available' ? 'success' : 'warning'}>{artifact.state}</Badge></div>
                      <h3 className="mt-4 font-semibold">{artifact.title ?? humanizeArtifactKind(artifact.kind)}</h3>
                      <p className="mt-1 text-sm text-stone-600">{artifact.mediaType} · {artifact.size.toLocaleString()} bytes</p>
                      <code className="mt-4 block truncate rounded-lg bg-stone-100 p-2 text-xs">sha256:{artifact.sha256}</code>
                    </Card>
                  </Link>
                ))}
              </div>
            )}
          </section>
        </div>
      ) : null}
    </div>
  );
}

function humanizeArtifactKind(value: string) {
  return value.replace(/[._-]+/gu, ' ').replace(/\b\w/gu, character => character.toUpperCase());
}
