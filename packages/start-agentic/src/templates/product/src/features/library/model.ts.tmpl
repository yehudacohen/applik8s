import type { ApplicationModelViewContext } from '@applik8s/applik8s';
import {
  applicationArtifactDetailSchema,
  applicationArtifactLibrarySchema,
  applicationArtifactSafeFileName,
  listApplicationArtifacts,
  loadApplicationArtifact,
} from '@applik8s/artifacts';
import { type } from 'arktype';
import { ArtifactObjects, Artifacts } from '../../modules';
import { database } from '../../providers';
import { Authenticated } from '../workspaces/model';
import { agenticWorkspaceScope } from '../../workspace-scope';
import { application } from '../../app';

export const WorkspaceLibrary = Artifacts.Artifact.view({
  input: type({}),
  output: applicationArtifactLibrarySchema,
  database,
  authorize: ({ principal }: { readonly principal: { readonly id: string } }) => principal.id.length > 0,
  budgets: { timeoutMs: 2_000, maxRows: 200, maxResultBytes: 512_000 },
}, async function loadWorkspaceLibrary(_input, context: ApplicationModelViewContext) {
  return listApplicationArtifacts(_input, context, {
    database,
    scope: agenticWorkspaceScope,
    title: artifactProvenanceTitle,
  });
});

Authenticated.can(WorkspaceLibrary);

export const ArtifactDetail = Artifacts.Artifact.view({
  input: type({ id: 'string' }),
  output: applicationArtifactDetailSchema,
  database,
  authorize: ({ principal }: { readonly principal: { readonly id: string } }) => principal.id.length > 0,
  budgets: { timeoutMs: 2_000, maxRows: 1, maxResultBytes: 64_000 },
}, async function loadArtifact(input: { readonly id: string }, context: ApplicationModelViewContext) {
  return loadApplicationArtifact(input, context, {
    database,
    scope: agenticWorkspaceScope,
    title: artifactProvenanceTitle,
  });
});

Authenticated.can(ArtifactDetail);

const artifactDownloads = application.http('artifact-downloads');
export const DownloadArtifact = artifactDownloads.post(
  'download-artifact',
  '/artifacts/download',
  {
    input: type({ id: 'string' }),
    output: type({
      url: 'string',
      expiresAt: 'string',
      mediaType: 'string',
      fileName: 'string',
    }),
    authorize: (_request, context) => context.principal.id.length > 0,
  },
  async function authorizeArtifactDownload(request) {
    const { value: artifact } = await Artifacts.Artifact.require(request.input.id);
    if (artifact.state !== 'available') throw new Error('The artifact is unavailable or outside the admitted workspace.');
    const title = artifactProvenanceTitle(artifact.provenance) ?? 'artifact';
    const intent = await ArtifactObjects.signDownload({ key: artifact.objectKey });
    return {
      url: intent.url,
      expiresAt: intent.expiresAt,
      mediaType: artifact.mediaType,
      fileName: `${applicationArtifactSafeFileName(title)}.${artifact.mediaType === 'text/markdown' ? 'md' : 'bin'}`,
    };
  },
);

Authenticated.can(DownloadArtifact);

function artifactProvenanceTitle(value: unknown): string | undefined {
  if (!value || typeof value !== 'object') return undefined;
  const title = Reflect.get(value, 'documentTitle');
  return typeof title === 'string' && title.trim() ? title : undefined;
}
