import { useRef } from 'react';
import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import { Button, Textarea } from './ui';

export function MarkdownEditor({
  value,
  onChange,
  label = 'Content',
}: {
  readonly value: string;
  readonly onChange: (value: string) => void;
  readonly label?: string;
}) {
  const textarea = useRef<HTMLTextAreaElement>(null);
  function insert(prefix: string, suffix = '', fallback = 'text') {
    const element = textarea.current;
    if (!element) return;
    const start = element.selectionStart;
    const end = element.selectionEnd;
    const selection = value.slice(start, end) || fallback;
    const next = `${value.slice(0, start)}${prefix}${selection}${suffix}${value.slice(end)}`;
    onChange(next);
    queueMicrotask(() => {
      element.focus();
      element.setSelectionRange(start + prefix.length, start + prefix.length + selection.length);
    });
  }
  return (
    <div className="overflow-hidden rounded-xl border border-stone-300 bg-white focus-within:border-emerald-600 focus-within:ring-2 focus-within:ring-emerald-600/20">
      <div role="toolbar" className="flex flex-wrap gap-1 border-b border-stone-200 bg-stone-50 p-2" aria-label="Document formatting">
        <Button type="button" variant="ghost" size="sm" className="editor-tool" onClick={() => insert('## ', '', 'Section title')} aria-label="Add section heading">H2</Button>
        <Button type="button" variant="ghost" size="sm" className="editor-tool font-bold" onClick={() => insert('**', '**')} aria-label="Bold selection">B</Button>
        <Button type="button" variant="ghost" size="sm" className="editor-tool" onClick={() => insert('- [ ] ', '', 'Action item')} aria-label="Add checklist item">☐</Button>
        <Button type="button" variant="ghost" size="sm" className="editor-tool" onClick={() => insert('> ', '', 'Important note')} aria-label="Add quote">❯</Button>
        <span className="ml-auto self-center pr-2 text-xs text-stone-500">Markdown · preview before publishing</span>
      </div>
      <Textarea
        ref={textarea}
        aria-label={label}
        className="min-h-[32rem] w-full resize-y border-0 bg-white p-4 font-mono text-sm leading-7 outline-none"
        value={value}
        onChange={event => onChange(event.currentTarget.value)}
      />
    </div>
  );
}

/** Standards-based, safely rendered GitHub-flavored Markdown presentation. */
export function MarkdownDocument({ source }: { readonly source: string }) {
  return (
    <article className="grid gap-4">
      <ReactMarkdown
        remarkPlugins={[remarkGfm]}
        components={{
        // The surrounding document route owns the page-level h1. Markdown
        // headings begin at h2 so authored content preserves one page title.
        h1: props => <h2 className="mt-8 text-3xl font-semibold tracking-tight first:mt-0" {...props} />,
        h2: props => <h3 className="mt-7 text-2xl font-semibold tracking-tight first:mt-0" {...props} />,
        h3: props => <h4 className="mt-6 text-lg font-semibold tracking-tight first:mt-0" {...props} />,
        h4: props => <h5 className="mt-5 font-semibold tracking-tight first:mt-0" {...props} />,
        p: props => <p className="leading-7 text-stone-700 dark:text-stone-200" {...props} />,
        ul: props => <ul className="list-disc space-y-2 pl-6 text-stone-700 dark:text-stone-200" {...props} />,
        ol: props => <ol className="list-decimal space-y-2 pl-6 text-stone-700 dark:text-stone-200" {...props} />,
        blockquote: props => <blockquote className="border-l-4 border-emerald-300 pl-4 italic text-stone-600 dark:text-stone-300" {...props} />,
        pre: props => <pre className="overflow-x-auto rounded-xl bg-stone-950 p-4 text-sm text-stone-100" {...props} />,
        code: props => <code className="rounded bg-stone-100 px-1 py-0.5 text-[.9em] dark:bg-stone-800" {...props} />,
        a: props => <a className="font-medium text-emerald-800 underline dark:text-emerald-300" rel="noreferrer" target="_blank" {...props} />,
        table: props => <div className="overflow-x-auto"><table className="w-full border-collapse text-left text-sm" {...props} /></div>,
        th: props => <th className="border-b border-stone-300 px-3 py-2 font-semibold dark:border-stone-700" {...props} />,
        td: props => <td className="border-b border-stone-100 px-3 py-2 text-stone-700 dark:border-stone-800 dark:text-stone-200" {...props} />,
        }}
      >
        {source}
      </ReactMarkdown>
    </article>
  );
}

export function documentTitle(source: string) {
  const first = source.split(/\r?\n/u).find(line => line.trim().length > 0)?.trim() ?? 'Untitled document';
  return first.replace(/^#{1,4}\s+/u, '').replace(/^[-*>]\s+/u, '').slice(0, 96);
}

export function documentExcerpt(source: string) {
  const lines = source.split(/\r?\n/u).map(line => line.trim()).filter(Boolean);
  const body = lines.slice(lines[0]?.startsWith('#') ? 1 : 0).join(' ');
  return (body || documentTitle(source)).replace(/[*_`>#]/gu, '').slice(0, 240);
}
