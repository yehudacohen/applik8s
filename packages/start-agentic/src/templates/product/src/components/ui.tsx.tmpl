export function humanizePrincipal(value: string) {
  const subject = value.split(':').filter(Boolean).at(-1) ?? value;
  const serviceNames: Readonly<Record<string, string>> = {
    'starter-decision-worker': 'Review automation',
    'agent-evaluation-worker': 'Agent evaluation service',
    'workspace-assistant': 'Workspace assistant',
  };
  if (serviceNames[subject]) return serviceNames[subject];
  if (/^\d+$/u.test(subject)) return 'Workspace member';
  return subject
    .replace(/[-_.]+/gu, ' ')
    .replace(/\b\p{L}/gu, character => character.toUpperCase());
}

export function Field({ label, hint, error, children }: {
  readonly label: ReactNode;
  readonly hint?: ReactNode;
  readonly error?: ReactNode;
  readonly children: ReactNode;
}) {
  return (
    <div className="grid gap-1.5">
      <div className="text-sm font-semibold text-stone-800 dark:text-stone-100">{label}</div>
