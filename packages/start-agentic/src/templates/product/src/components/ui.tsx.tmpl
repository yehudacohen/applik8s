  );
}

export function LiveQueryStatus({ phase, onRetry, label = 'Live updates' }: {
  readonly phase: string;
  readonly onRetry?: () => void | Promise<void>;
  readonly label?: string;
}) {
  const [degraded, setDegraded] = useState(false);
  useEffect(() => {
    if (phase !== 'reconnecting') {
      setDegraded(false);
      return;
    }
    const timer = globalThis.setTimeout(() => setDegraded(true), 8_000);
    return () => globalThis.clearTimeout(timer);
  }, [phase]);
  if (phase !== 'reconnecting') return null;
  if (!degraded) return <Badge tone="warning">Reconnecting…</Badge>;
  return <Alert tone="warning" title={`${label} are interrupted`} action={onRetry ? <Button type="button" variant="secondary" onClick={() => void onRetry()}>Retry now</Button> : undefined}>Saved work remains authoritative. This page will reconnect automatically, or you can retry now.</Alert>;
}

