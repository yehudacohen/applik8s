import { Separator as SeparatorPrimitive } from 'radix-ui';
import type { ComponentProps } from 'react';
import { cn } from '#lib/utils';

export function Separator({ className, orientation = 'horizontal', decorative = true, ...props }: ComponentProps<typeof SeparatorPrimitive.Root>) {
  return <SeparatorPrimitive.Root data-slot="separator" decorative={decorative} orientation={orientation} className={cn('shrink-0 bg-stone-200 dark:bg-stone-700', orientation === 'horizontal' ? 'my-5 h-px w-full' : 'h-full w-px', className)} {...props} />;
}
