import { app } from '@applik8s/applik8s';
import { Installation, InstallationStatus } from './installation';

export const application = app("applik8s-template-project", {
  namespace: applicationNamespace("applik8s-template-project"),
  spec: Installation,
  status: InstallationStatus,
});

function applicationNamespace(name: string): string {
  return `${name}-system`;
}
