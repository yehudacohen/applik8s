import { applicationGraphFor } from '@applik8s/applik8s';
import { assembleApplicationKnowledgeContext } from '@applik8s/knowledge';
import { AgenticStarter } from '@applik8s/start-agentic';
import { describe, expect, it } from 'vitest';
import {
  Document,
  DocumentList,
  KnowledgeSearch,
  WorkspaceAssistant,
  WorkspaceActivity,
  WorkspaceDigestSchedule,
  HistoricalUsagePublication,
  application,
} from '../src/application';
import {
  canManageWorkspaceBilling,
  trustedBillingReturnUrl,
} from '../src/features/billing-policy';

describe('generated application', () => {
  it('discovers one typed model, view, agent, and explicit authority graph', () => {
    const graph = applicationGraphFor(application.composition);

    expect(Document.create).toBeTypeOf('function');
    expect(DocumentList).toBeTypeOf('function');
    expect(WorkspaceAssistant).toMatchObject({
      kind: 'applicationAgent',
      name: 'workspace-assistant',
    });
    expect(WorkspaceAssistant.handler).toBeTypeOf('function');
    expect(graph?.nodes).toEqual(expect.arrayContaining([
      expect.objectContaining({ kind: 'model', id: 'model.document' }),
      expect.objectContaining({ kind: 'aiAgent', name: 'workspace-assistant' }),
    ]));
    expect(graph?.nodes).toEqual(expect.arrayContaining([
      expect.objectContaining({
        kind: 'authorityManifest',
        manifest: expect.objectContaining({
          grants: expect.arrayContaining([expect.any(Object)]),
        }),
      }),
    ]));
  });

  it('ships durable run hydration and an authorized search-backed knowledge path', () => {
    const graph = applicationGraphFor(application.composition);

    expect(KnowledgeSearch).toMatchObject({
      kind: 'applicationSearchIndex',
      name: 'workspace-knowledge-search',
    });
    expect(graph?.nodes).toEqual(expect.arrayContaining([
      expect.objectContaining({
        kind: 'index',
        name: 'workspace-knowledge-search',
      }),
      expect.objectContaining({
        kind: 'model',
        id: 'model.protocol-run',
      }),
    ]));
  });

  it('keeps v0.8 stateful capabilities provider-neutral in product source', () => {
    const graph = applicationGraphFor(application.composition);

    expect(WorkspaceActivity).toMatchObject({
      kind: 'applicationActor',
      id: 'workspace-activity.v1',
    });
    expect(WorkspaceActivity.snapshot.authority.classification).toBe('application-policy');
    expect(WorkspaceActivity.record.send.authority.classification).toBe('application-policy');
    expect(WorkspaceActivity.alarms.expire.schedule.authority.classification).toBe('application-policy');
    expect(WorkspaceDigestSchedule.kind).toBe('applicationSchedule');
    expect(WorkspaceDigestSchedule.definition).toMatchObject({
      configuration: 'dynamic',
    });
    expect(HistoricalUsagePublication).toMatchObject({
      kind: 'applicationLakehousePublication',
      dataset: { qualification: { name: 'historical-usage' } },
    });
    expect(WorkspaceDigestSchedule.graphNode).toMatchObject({
      kind: 'schedule',
      id: 'schedule.agentic.workspace-digest.v1',
    });
    expect(HistoricalUsagePublication.graphNode).toMatchObject({
      kind: 'lakehousePublication',
    });
    expect(graph?.nodes).toEqual(expect.arrayContaining([
      expect.objectContaining({ kind: 'actor', id: 'actor.workspace-activity.v1' }),
      expect.objectContaining({ kind: 'provider', interface: 'Observability' }),
    ]));
  });

  it('validates model input and the deterministic Starter tool fixture', () => {
    const fixture = AgenticStarter.inference().fixture;
    const toolInput = fixture?.tool?.input;

    expect(fixture).toBeDefined();
    expect(Document.$model.schema.insert({ body: 'A typed document' })).not.toHaveProperty(
      'problems',
    );
    expect(toolInput).toMatchObject({
      body: expect.stringContaining('## Execution plan'),
    });
    expect(Document.$model.schema.insert(toolInput ?? {})).not.toHaveProperty(
      'problems',
    );
  });

  it('does not mistake transport reachability for anonymous authority', () => {
    const graph = applicationGraphFor(application.composition);
    const manifest = graph?.nodes.find(
      (node) => node.kind === 'authorityManifest',
    );

    expect(Document.create.authority).toMatchObject({
      classification: 'assigned',
      permissionIds: expect.arrayContaining([expect.any(String)]),
    });
    expect(manifest).toMatchObject({
      kind: 'authorityManifest',
      manifest: {
        roles: expect.arrayContaining([
          expect.objectContaining({ name: 'authenticated' }),
        ]),
      },
    });
    expect(JSON.stringify(manifest)).not.toContain('"name":"anonymous"');
  });

  it('fails shared-workspace billing closed for ordinary members and unsafe returns', () => {
    expect(canManageWorkspaceBilling({
      principal: { roles: ['member'] },
      trustedContext: { workspaceId: 'workspace-one' },
    })).toBe(false);
    expect(canManageWorkspaceBilling({
      principal: { roles: ['workspace-owner'] },
      trustedContext: { workspaceId: 'workspace-one' },
    })).toBe(true);
    expect(() => trustedBillingReturnUrl(
      'https://attacker.example/app/billing',
      'https://product.example',
    )).toThrow(/this application's Billing page/u);
    expect(trustedBillingReturnUrl(
      'https://product.example/app/billing?checkout=complete',
      'https://product.example',
    )).toBe('https://product.example/app/billing?checkout=complete');
  });

  it('bounds relevance-ranked knowledge before it enters an agent prompt', () => {
    const context = assembleApplicationKnowledgeContext([
      { id: 'one', title: 'First', content: '😀'.repeat(20_000) },
      { id: 'two', title: 'Second', content: 'second'.repeat(20_000) },
    ], { maximumBytes: 48_000, maximumSourceBytes: 12_000 });

    expect(new TextEncoder().encode(context).byteLength).toBeLessThanOrEqual(48_000);
    expect(context).toContain('## First');
  });
});
