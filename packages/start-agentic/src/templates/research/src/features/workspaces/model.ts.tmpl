import {
  applicationCausalPrincipalContext,
  type ApplicationModelViewContext,
  module,
} from '@applik8s/applik8s';
import { AgenticWorkspaceId } from '@applik8s/start-agentic';
import { type } from 'arktype';
import { and, eq, or, sql } from 'drizzle-orm';
import { application } from '../../app';
import { Notifications } from '../../modules';
import { database } from '../../providers';
import {
  Invitation as InvitationTable,
  InvitationRelations,
  Membership as MembershipTable,
  MembershipRelations,
  Workspace as WorkspaceTable,
  WorkspaceRelations,
} from './schema';

export const WorkspaceId = AgenticWorkspaceId;
const WorkspaceMembershipBootstrapSubject = 'workspace-membership-bootstrap';

async function listWorkspaces(
  _input: object,
  context: ApplicationModelViewContext,
) {
  const client = context.database(database);
  return client.select({
    id: WorkspaceTable.id,
    slug: WorkspaceTable.slug,
    name: WorkspaceTable.name,
    role: sql<string>`CASE
      WHEN ${WorkspaceTable.ownerPrincipalId} = ${context.principal.id}
        THEN 'workspace-owner'
      ELSE ${MembershipTable.role}
    END`,
  })
  .from(WorkspaceTable)
  .leftJoin(
    MembershipTable,
    and(
      eq(MembershipTable.workspaceId, WorkspaceTable.id),
      eq(MembershipTable.identityId, context.principal.id),
    ),
  )
  .where(or(
    eq(WorkspaceTable.ownerPrincipalId, context.principal.id),
    eq(MembershipTable.identityId, context.principal.id),
  ))
  .limit(100);
}

const WorkspaceDashboardResult = type({
  workspace: {
    id: 'string',
    slug: 'string',
    name: 'string',
    role: 'string',
  },
  members: type({
    id: 'string',
    identityId: 'string',
    role: "'workspace-owner' | 'workspace-administrator' | 'workspace-member'",
    createdAt: 'string',
  }).array(),
  invitations: type({
    id: 'string',
    email: 'string',
    role: 'string',
    state: 'string',
    expiresAt: 'string',
  }).array(),
}).or('null');

async function loadWorkspaceDashboard(
  input: { readonly workspaceId: string },
  context: ApplicationModelViewContext,
) {
    const client = context.database(database);
    const [row] = await client.select({
      id: WorkspaceTable.id,
      slug: WorkspaceTable.slug,
      name: WorkspaceTable.name,
      ownerPrincipalId: WorkspaceTable.ownerPrincipalId,
      createdAt: WorkspaceTable.createdAt,
      role: sql<string>`CASE
        WHEN ${WorkspaceTable.ownerPrincipalId} = ${context.principal.id}
          THEN 'workspace-owner'
        ELSE ${MembershipTable.role}
      END`,
    })
    .from(WorkspaceTable)
    .leftJoin(
      MembershipTable,
      and(
        eq(MembershipTable.workspaceId, WorkspaceTable.id),
        eq(MembershipTable.identityId, context.principal.id),
      ),
    )
    .where(and(
      eq(WorkspaceTable.id, input.workspaceId),
      or(
        eq(WorkspaceTable.ownerPrincipalId, context.principal.id),
        eq(MembershipTable.identityId, context.principal.id),
      ),
    ))
    .limit(1);
    if (!row) return null;
    const storedMembers = await client.select({
      id: MembershipTable.id,
      identityId: MembershipTable.identityId,
      role: MembershipTable.role,
      createdAt: MembershipTable.createdAt,
    })
    .from(MembershipTable)
    .where(eq(MembershipTable.workspaceId, row.id))
    .limit(250);
    const members = storedMembers.some(
      member => member.identityId === row.ownerPrincipalId,
    )
      ? storedMembers
      : [{
          id: row.id,
          identityId: row.ownerPrincipalId,
          role: 'workspace-owner' as const,
          createdAt: row.createdAt,
        }, ...storedMembers];
    const invitations = ['workspace-owner', 'workspace-administrator'].includes(row.role)
      ? await client.select({
          id: InvitationTable.id,
          email: InvitationTable.email,
          role: InvitationTable.role,
          state: InvitationTable.state,
          expiresAt: InvitationTable.expiresAt,
        })
        .from(InvitationTable)
        .where(eq(InvitationTable.workspaceId, row.id))
        .limit(250)
      : [];
  const workspace = {
    id: row.id,
    slug: row.slug,
    name: row.name,
    role: row.role,
  };
  return { workspace, members, invitations };
}

const workspaces = module(
  'workspaces',
  {
    schema: {
      Workspace: WorkspaceTable,
      Membership: MembershipTable,
      Invitation: InvitationTable,
      WorkspaceRelations,
      MembershipRelations,
      InvitationRelations,
    },
  },
  (application) => {
      const WorkspaceMembershipBootstrapIdentity = application.serviceIdentity(
        'workspace-membership-bootstrap',
      );
      WorkspaceTable.create.beforeCommit(
        { history: true },
        async function establishWorkspaceOwnership(workspace, input, context) {
          const principal = context.principal;
          if (!principal) {
            throw new Error('Workspace creation requires an authenticated identity.');
          }
          if (
            input.id !== undefined
            || input.ownerPrincipalId !== undefined
            || input.state !== undefined
            || input.createdAt !== undefined
          ) {
            throw new Error(
              'Workspace identity, ownership, lifecycle state, and timestamps are server-owned.',
            );
          }
          workspace.patch({
            spec: {
              ownerPrincipalId: applicationCausalPrincipalContext(principal).id,
              state: 'active',
              createdAt: context.now,
            },
          });
        },
      );
      const WorkspaceMembershipBootstrap = WorkspaceTable.on.create(
        {
          processor: { replicas: 1, concurrency: 8 },
          retry: {
            maxAttempts: 5,
            initialDelayMs: 100,
            maxDelayMs: 5_000,
            deadLetter: true,
          },
          budgets: { timeoutMs: 5_000, maxInputBytes: 32_000 },
        },
        async function createOwningMembership(created) {
          await MembershipTable.create({
            workspaceId: created.value.id,
            identityId: created.value.ownerPrincipalId,
            role: 'workspace-owner',
          });
        },
      );
      MembershipTable.create.beforeCommit(
        { history: true },
        async function protectWorkspaceMembershipCreation(_membership, input, context) {
          if (input.role !== 'workspace-owner') return;
          const principal = context.principal;
          if (
            principal?.kind !== 'execution'
            || principal.serviceIdentity?.subject !== WorkspaceMembershipBootstrapSubject
            || principal.causalPrincipalId !== input.identityId
          ) {
            throw new Error(
              'Workspace ownership is created only by the framework-owned workspace bootstrap.',
            );
          }
        },
      );
      MembershipTable.update.beforeCommit(
        { history: true },
        async function protectMembershipRole(member, input) {
          if (member.value.role === 'workspace-owner') {
            throw new Error('Workspace ownership cannot be changed through membership role management.');
          }
          const fields = Object.keys(input.patch);
          if (fields.length !== 1 || fields[0] !== 'role' || input.patch.role === 'workspace-owner') {
            throw new Error('Membership updates may only select administrator or member.');
          }
        },
      );
      MembershipTable.delete.beforeCommit(
        { history: true },
        async function protectOwningMembership(member) {
          if (member.value.role === 'workspace-owner') {
            throw new Error('Transfer workspace ownership before removing the owner.');
          }
        },
      );
      InvitationTable.create.beforeCommit(
        { history: true },
        async function protectWorkspaceInvitationCreation(_invitation, input) {
          if (input.role === 'workspace-owner') {
            throw new Error('Workspace ownership cannot be granted through an invitation.');
          }
        },
      );
      InvitationTable.update.beforeCommit(
        { history: true },
        async function protectWorkspaceInvitationUpdate(_invitation, input) {
          if ('role' in input.patch && input.patch.role === 'workspace-owner') {
            throw new Error('Workspace ownership cannot be granted through an invitation.');
          }
        },
      );
      WorkspaceTable.update.beforeCommit(
        { history: true },
        async function protectWorkspaceUpdate(_workspace, input) {
          const fields = Object.keys(input.patch);
          if (fields.length === 0 || fields.some(field => field !== 'name' && field !== 'slug')) {
            throw new Error('Workspace updates may change only its name or slug.');
          }
        },
      );
      const InvitationDelivery = InvitationTable.on.create(
        {
          processor: { replicas: 1, concurrency: 8 },
          retry: {
            maxAttempts: 8,
            initialDelayMs: 500,
            maxDelayMs: 30_000,
            deadLetter: true,
          },
          budgets: { timeoutMs: 5_000, maxInputBytes: 32_000 },
        },
        async function requestInvitationDelivery(created) {
          await Notifications.request({
            id: `workspace-invitation:${created.value.id}`,
            idempotencyKey: `workspace-invitation:${created.value.id}:created`,
            recipient: { email: created.value.email },
            content: {
              subject: 'You have been invited to a workspace',
              text: [
                'A workspace owner invited you to join their application workspace.',
                `Invitation: ${created.value.id}`,
                `Role: ${created.value.role}`,
                `Expires: ${created.value.expiresAt}`,
                `Open /invitations/${created.value.id} in the application to accept.`,
              ].join('\n'),
            },
            template: { id: 'workspace-invitation', version: 'v1' },
            tags: { workspaceId: created.value.workspaceId },
          });
        },
      );
      const WorkspaceList = WorkspaceTable.view(
        {
          input: type({}),
          output: type({
            id: 'string',
            slug: 'string',
            name: 'string',
            role: 'string',
          }).array(),
          database,
          authorize: ({ principal }) => principal.id.length > 0,
          budgets: { timeoutMs: 2_000, maxRows: 100, maxResultBytes: 128_000 },
        },
        listWorkspaces,
      );
      const WorkspaceDashboard = WorkspaceTable.view(
        {
          input: type({ workspaceId: 'string' }),
          output: WorkspaceDashboardResult,
          database,
          reads: [MembershipTable, InvitationTable],
          authorize: ({ principal }) => principal.id.length > 0,
          budgets: { timeoutMs: 2_000, maxRows: 500, maxResultBytes: 256_000 },
        },
        loadWorkspaceDashboard,
      );

      const Authenticated = application.role('authenticated');
      const Owner = application.role('workspace-owner');
      const Administrator = application.role('workspace-administrator');
      const Member = application.role('workspace-member');
      Authenticated.can(
        WorkspaceTable.create.all(),
        WorkspaceList,
        WorkspaceDashboard,
      );
      Owner.can(
        WorkspaceTable.update.where(
          workspace => workspace.id.eq(WorkspaceId),
        ),
        WorkspaceTable.delete.where(
          workspace => workspace.id.eq(WorkspaceId),
        ),
        MembershipTable.create.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        MembershipTable.update.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        MembershipTable.delete.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.create.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.update.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.delete.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        WorkspaceList,
        WorkspaceDashboard,
      );
      Administrator.can(
        WorkspaceTable.update.where(
          workspace => workspace.id.eq(WorkspaceId),
        ),
        MembershipTable.create.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        MembershipTable.update.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        MembershipTable.delete.where(
          membership => membership.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.create.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.update.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        InvitationTable.delete.where(
          invitation => invitation.workspaceId.eq(WorkspaceId),
        ),
        WorkspaceList,
        WorkspaceDashboard,
      );
      Member.can(WorkspaceList, WorkspaceDashboard);
      WorkspaceMembershipBootstrapIdentity.can(MembershipTable.create.all());
      return {
        Workspace: WorkspaceTable,
        Membership: MembershipTable,
        Invitation: InvitationTable,
        WorkspaceList,
        WorkspaceDashboard,
        WorkspaceMembershipBootstrap,
        InvitationDelivery,
        Authenticated,
        Owner,
        Administrator,
        Member,
      };
  },
);

export const Workspaces = application.include(workspaces);
export const {
  Workspace,
  Membership,
  Invitation,
  WorkspaceDashboard,
  WorkspaceList,
  InvitationDelivery,
  Authenticated,
  Owner,
  Administrator,
  Member,
} = Workspaces;
