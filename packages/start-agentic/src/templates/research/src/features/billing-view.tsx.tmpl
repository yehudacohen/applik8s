import {
  type FormEvent,
  useState,
} from 'react';
import {
  BillingDashboard,
  CancelSubscription,
  ChangeSubscription,
  OpenBillingPortal,
  ResumeSubscription,
  StartCheckout,
} from '../application';

export function BillingDashboardView() {
  const dashboard = BillingDashboard({}).useQuery();
  const subscription = dashboard.data?.subscription;
  const includedPlan = dashboard.data?.plans.find(plan => plan.priceMicrounits === 0);
  const [notice, setNotice] = useState<string>();
  const [failure, setFailure] = useState<string>();
  const [pending, setPending] = useState(false);
  const [providerSessionStarted, setProviderSessionStarted] = useState(false);

  async function choose(
    event: FormEvent<HTMLFormElement>,
    plan: string,
  ) {
    event.preventDefault();
    setFailure(undefined);
    setPending(true);
    try {
      const subscription = dashboard.data?.subscription;
      if (subscription) {
        const result = await ChangeSubscription({
          intentId: crypto.randomUUID(),
          plan,
          timing: 'immediate',
        });
        setNotice(
          result.state === 'scheduled'
            ? `Plan change scheduled for ${result.effectiveAt}.`
            : 'Plan changed.',
        );
      } else {
        const result = await StartCheckout({
          intentId: crypto.randomUUID(),
          plan,
          returnTo: globalThis.location.href,
        });
        setNotice(
          result.mode === 'simulated'
            ? 'Starter checkout is simulated and non-production.'
            : 'Continue to the payment provider.',
        );
        if (result.mode === 'simulated') setProviderSessionStarted(true);
        if (result.mode === 'live') globalThis.location.assign(result.url);
      }
    } catch (error) {
      setFailure(actionFailure(error, 'Checkout could not be started.'));
    } finally {
      setPending(false);
    }
  }

  async function openPortal() {
    setFailure(undefined);
    setPending(true);
    try {
      const result = await OpenBillingPortal({
        intentId: crypto.randomUUID(),
        returnTo: globalThis.location.href,
      });
      setNotice(
        result.mode === 'simulated'
          ? 'Starter billing portal is simulated and non-production.'
          : 'Continue to the payment provider.',
      );
      if (result.mode === 'live') globalThis.location.assign(result.url);
    } catch (error) {
      setFailure(actionFailure(error, 'Billing portal could not be opened.'));
    } finally {
      setPending(false);
    }
  }

  async function cancel() {
    const subscription = dashboard.data?.subscription;
    if (!subscription) return;
    setFailure(undefined);
    setPending(true);
    try {
      const result = await CancelSubscription({
        intentId: crypto.randomUUID(),
        timing: 'periodEnd',
      });
      setNotice(`Cancellation scheduled for ${result.effectiveAt}.`);
    } catch (error) {
      setFailure(actionFailure(error, 'Subscription could not be cancelled.'));
    } finally {
      setPending(false);
    }
  }

  async function resume() {
    const subscription = dashboard.data?.subscription;
    if (!subscription) return;
    setFailure(undefined);
    setPending(true);
    try {
      await ResumeSubscription({ intentId: crypto.randomUUID() });
      setNotice('Subscription resumed.');
    } catch (error) {
      setFailure(actionFailure(error, 'Subscription could not be resumed.'));
    } finally {
      setPending(false);
    }
  }

  return (
    <main>
      <p className="eyebrow">Provider-neutral billing</p>
      <h1>Plan, usage, and entitlements</h1>
      <p>
        Product state is canonical application data. Payment-provider details
        and credentials remain server-only.
      </p>
      <section aria-label="Current plan">
        <h2>Current plan</h2>
        <p>
          {subscription
            ? `${subscription.planId} · ${subscription.status}`
            : includedPlan
              ? `${includedPlan.name} · included`
              : 'No plan configured'}
        </p>
        {subscription || providerSessionStarted ? <button type="button" onClick={openPortal} disabled={pending}>
          Open billing portal
        </button> : null}
        {subscription?.status === 'cancelled' ? (
          <button type="button" onClick={resume} disabled={pending}>
            Resume subscription
          </button>
        ) : subscription ? (
          <button type="button" onClick={cancel} disabled={pending}>
            Cancel at period end
          </button>
        ) : null}
      </section>
      <section aria-label="Plans">
        <h2>Plans</h2>
        {dashboard.data?.plans.map(plan => {
          const current = subscription
            ? subscription.planId === plan.id
            : plan.priceMicrounits === 0;
          return <div key={plan.id}>
            <strong>{plan.name}</strong>
            <p>{plan.description}</p>
            {current ? <strong>Current plan</strong>
              : plan.priceMicrounits === 0
                ? <p>Becomes current after the paid subscription ends.</p>
                : <form onSubmit={event => choose(event, plan.id)}><button type="submit" disabled={pending}>Choose {plan.name}</button></form>}
          </div>;
        })}
      </section>
      <section aria-label="Usage">
        <h2>Usage</h2>
        <p>
          {dashboard.data?.usage.inputTokens ?? 0} input tokens ·{' '}
          {dashboard.data?.usage.outputTokens ?? 0} output tokens ·{' '}
          {dashboard.data?.usage.costMicrounits ?? 0} cost µ-units
        </p>
      </section>
      <section aria-label="Entitlements">
        <h2>Entitlements</h2>
        {dashboard.data?.entitlements.map(entitlement => (
          <p key={entitlement.capability}>
            {entitlement.capability}: {entitlement.limit ?? 'unlimited'}
          </p>
        ))}
      </section>
      {failure ? <p role="alert">{failure}</p> : null}
      {notice ? <p role="status">{notice}</p> : null}
    </main>
  );
}

function actionFailure(error: unknown, fallback: string): string {
  return error instanceof Error && error.message.trim()
    ? `${fallback} ${error.message}`
    : fallback;
}
