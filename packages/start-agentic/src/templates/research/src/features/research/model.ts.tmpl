import { AI } from '@applik8s/ai';
import { module, search } from '@applik8s/applik8s';
import { researchAgent } from '@applik8s/research';
import { AgenticPrincipalScope, AgenticResearch } from '@applik8s/start-agentic';
import { application } from '../../app';
import { inference, webSearch } from '../../providers';
import { ResearchNote as ResearchNoteTable } from './schema';

/**
 * Ordinary provider-neutral retrieval. The application still owns durable
 * evidence, source classification, disclosure, and citation policy.
 */
export async function findPublicSources(query: string) {
  return webSearch.search({
    query,
    limit: 8,
    safeSearch: 'moderate',
    timeoutMs: 10_000,
  });
}

const research = module(
  'research',
  {
    schema: { ResearchNote: ResearchNoteTable },
  },
  (application) => {
      const ResearcherIdentity = application.serviceIdentity('researcher');
      const FastModel = AI.model('fast', {
        inference,
        capabilities: [AI.chat, AI.tools, AI.streaming],
      });
      const ResearchNotes = ResearchNoteTable.index(
        'research-notes',
        search.text(ResearchNoteTable.body, { boost: 2 }).as('body'),
        search.filter(ResearchNoteTable.createdAt).as('createdAt'),
      );
      const Researcher = application.include(researchAgent(
        'researcher.v1',
        {
          identity: ResearcherIdentity,
          model: FastModel,
          search: AgenticResearch.search,
          retrieve: AgenticResearch.retrieve,
          evidence: AgenticResearch.evidence,
          scope: AgenticPrincipalScope,
          instructions: 'Research public sources and save a concise note whose claims are grounded in committed evidence.',
          tools: [ResearchNoteTable.create, ResearchNotes.search],
          query: {
            maximumResults: 8,
            maximumSources: 4,
            maximumConcurrency: 2,
          },
        },
      ));
      ResearcherIdentity.can(ResearchNoteTable.create, ResearchNotes.search);
      return {
        ResearchNote: ResearchNoteTable,
        ResearcherIdentity,
        FastModel,
        Researcher,
        ResearchNotes,
      };
  },
);

export const {
  ResearchNote,
  ResearcherIdentity,
  FastModel,
  Researcher,
  ResearchNotes,
} = application.include(research);
