import { AgenticStartOnboarding } from '@applik8s/start-agentic/react';
import { Link, useNavigate } from '@tanstack/react-router';
import { type FormEvent, useEffect, useState } from 'react';
import {
  Conversation,
  ConversationDetail,
  ConversationInbox,
  Researcher,
} from '../../application';
import type { ConversationSummaryValue } from '../conversations/model';

export function ResearchInbox() {
  const inbox = ConversationInbox({}).useQuery();
  const updateConversation = Conversation.update.useMutation();
  const navigate = useNavigate();

  async function beginConversation() {
    await navigate({
      to: '/conversations/$conversationId',
      params: { conversationId: crypto.randomUUID() },
    });
  }

  async function archiveConversation(conversationId: string) {
    await updateConversation({
      identity: conversationId,
      patch: { archivedAt: new Date().toISOString() },
    });
    await inbox.refresh();
  }

  return (
    <main data-applik8s-provenance="query.Conversation.listConversations">
      <AgenticStartOnboarding
        application="applik8s-template-project"
        operationsHref="/operations"
      />
      <p className="eyebrow">Applik8s Agentic Start</p>
      <h1>Research inbox</h1>
      <p>
        Conversations, messages, protocol runs, and stream events are durable
        application models scoped by authenticated identity and trusted context.
      </p>
      <button type="button" onClick={beginConversation}>
        New conversation
      </button>
      <section aria-label="Research conversations">
        {inbox.data?.map((conversation: ConversationSummaryValue) => (
          <article key={conversation.id}>
            <strong>{conversation.title ?? 'Untitled conversation'}</strong>
            <p>Updated {conversation.updatedAt}</p>
            <Link
              to="/conversations/$conversationId"
              params={{ conversationId: conversation.id }}
            >
              Open conversation
            </Link>
            <button
              type="button"
              disabled={updateConversation.pending}
              onClick={() => archiveConversation(conversation.id)}
            >
              Archive
            </button>
          </article>
        ))}
      </section>
    </main>
  );
}

export function ResearchConversation({
  conversationId,
}: {
  readonly conversationId: string;
}) {
  const detail = ConversationDetail({ conversationId }).useQuery();
  const updateConversation = Conversation.update.useMutation();
  const navigate = useNavigate();
  const [draft, setDraft] = useState('');
  const [title, setTitle] = useState('');
  const [pending, setPending] = useState(false);
  const [result, setResult] = useState<Awaited<ReturnType<typeof Researcher>>>();
  const [error, setError] = useState<string>();

  useEffect(() => {
    setTitle(detail.data?.conversation.title ?? '');
  }, [detail.data?.conversation.title]);

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const message = draft.trim();
    if (!message) return;
    setPending(true);
    setError(undefined);
    try {
      const invocationId = crypto.randomUUID();
      const terminal = await Researcher(
        { threadId: conversationId, question: message },
        { idempotencyKey: `${conversationId}:${invocationId}` },
      );
      setResult(terminal);
      setDraft('');
      await detail.refresh();
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : String(cause));
    } finally {
      setPending(false);
    }
  }

  async function rename(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const next = title.trim();
    if (!next) return;
    await updateConversation({
      identity: conversationId,
      patch: { title: next },
    });
    await detail.refresh();
  }

  async function archive() {
    await updateConversation({
      identity: conversationId,
      patch: { archivedAt: new Date().toISOString() },
    });
    await navigate({ to: '/' });
  }

  return (
    <main>
      <Link to="/">Back to inbox</Link>
      <p className="eyebrow">Durable conversation</p>
      <h1>{detail.data?.conversation.title ?? 'New research conversation'}</h1>
      <p>
        The URL carries only the conversation selector. Server-side principal
        scope determines whether existing history can be read.
      </p>
      {detail.data ? (
        <form onSubmit={rename}>
          <label htmlFor="conversation-title">Conversation title</label>
          <input
            id="conversation-title"
            value={title}
            onChange={(event) => setTitle(event.currentTarget.value)}
          />
          <button
            type="submit"
            disabled={updateConversation.pending || !title.trim()}
          >
            Rename
          </button>
          <button
            type="button"
            disabled={updateConversation.pending}
            onClick={archive}
          >
            Archive
          </button>
        </form>
      ) : null}
      <section aria-label="Research result" aria-live="polite">
        {pending ? <p>Searching, retrieving, recording evidence, and preparing the artifact…</p> : null}
        {result ? <ResearchTerminalResult result={result} /> : null}
        {error ? <p role="alert">{error}</p> : null}
      </section>
      <form onSubmit={submit}>
        <label htmlFor="research-prompt">Research prompt</label>
        <textarea
          id="research-prompt"
          value={draft}
          onChange={(event) => setDraft(event.currentTarget.value)}
          disabled={pending}
        />
        <button type="submit" disabled={pending || !draft.trim()}>
          {pending ? 'Researching…' : 'Research and publish'}
        </button>
      </form>
    </main>
  );
}

function ResearchTerminalResult({
  result,
}: {
  readonly result: Awaited<ReturnType<typeof Researcher>>;
}) {
  if (result.status === 'completed') return (
    <article data-status="completed">
      <p className="eyebrow">Published research</p>
      <h2>Grounded artifact ready</h2>
      <p>{result.value.body}</p>
      <p>Artifact {result.artifact.id} · {result.evidenceIds.length} evidence records</p>
    </article>
  );
  if (result.status === 'partial') return (
    <article data-status="partial">
      <p className="eyebrow">Partial research</p>
      <h2>Evidence retained; publication needs attention</h2>
      {result.value ? <p>{result.value.body}</p> : null}
      <p>{result.reason}</p>
      <ul>{result.unresolvedClaims.map(claim => <li key={claim}>{claim}</li>)}</ul>
      <p>{result.evidenceIds.length} evidence records retained for retry.</p>
    </article>
  );
  return (
    <article data-status="failed">
      <p className="eyebrow">Research failed safely</p>
      <h2>No completed report was claimed</h2>
      <p>{result.reason}</p>
      <p>{result.evidenceIds.length} evidence records were retained.</p>
    </article>
  );
}
