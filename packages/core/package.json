{
  "name": "@applik8s/core",
  "version": "0.8.0",
  "description": "Core types and contracts for applik8s TypeScript Kubernetes operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js",
      "default": "./dist/canonical-json.js"
    },
    "./admission": {
      "types": "./dist/application-admission.d.ts",
      "import": "./dist/application-admission.js",
      "default": "./dist/application-admission.js"
    }
  }
}
