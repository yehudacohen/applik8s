{
  "name": "@applik8s/applik8s",
  "version": "0.4.2",
  "description": "TypeScript framework for programming Kubernetes-native applications and operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/applik8s"
  },
  "bin": {
    "applik8s": "dist/bin.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./operator": { "types": "./dist/operator.d.ts", "import": "./dist/operator.js" },
    "./dsl": { "types": "./dist/dsl.d.ts", "import": "./dist/dsl.js" },
    "./typekro": { "types": "./dist/typekro.d.ts", "import": "./dist/typekro.js" },
    "./factories": { "types": "./dist/factories.d.ts", "import": "./dist/factories.js" },
    "./factories/*": { "types": "./dist/factories/*.d.ts", "import": "./dist/factories/*.js" },
    "./processor-runtime": { "types": "./dist/processor-runtime.d.ts", "import": "./dist/processor-runtime.js" },
    "./cli": { "types": "./dist/cli.d.ts", "import": "./dist/cli.js" }
  },
  "dependencies": {
    "@applik8s/compiler": "0.4.2",
    "@applik8s/core": "0.4.2",
    "@applik8s/sdk": "0.4.2",
    "@applik8s/typekro-adapter": "0.4.2",
    "@applik8s/typetainer": "0.4.2",
    "arktype": "^2.1.20",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.1",
    "esbuild": "^0.28.1",
    "hono": "^4.10.7",
    "nats": "^2.29.3",
    "postgres": "^3.4.7",
    "typekro": "^0.26.0"
  }
}
