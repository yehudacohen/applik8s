{
  "name": "@applik8s/runtime-postgres",
  "version": "0.9.0",
  "description": "PostgreSQL wire-client runtime for Applik8s models, commands, streams, and projections.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/runtime-postgres"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "import": "./dist/sql.js",
      "default": "./dist/sql.js"
    },
    "./schedule-state": {
      "types": "./dist/schedule-state.d.ts",
      "import": "./dist/schedule-state.js",
      "default": "./dist/schedule-state.js"
    },
    "./schedule-occurrence": {
      "types": "./dist/schedule-occurrence.d.ts",
      "import": "./dist/schedule-occurrence.js",
      "default": "./dist/schedule-occurrence.js"
    },
    "./job-store": {
      "types": "./dist/job-store.d.ts",
      "import": "./dist/job-store.js",
      "default": "./dist/job-store.js"
    },
    "./managed-model-store": {
      "types": "./dist/managed-model-store.d.ts",
      "import": "./dist/managed-model-store.js",
      "default": "./dist/managed-model-store.js"
    },
    "./operator-runtime": {
      "types": "./dist/operator-runtime.d.ts",
      "import": "./dist/operator-runtime.js",
      "default": "./dist/operator-runtime.js"
    },
    "./query-selection": {
      "types": "./dist/query-selection.d.ts",
      "import": "./dist/query-selection.js",
      "default": "./dist/query-selection.js"
    },
    "./query-batch": {
      "types": "./dist/query-batch.d.ts",
      "import": "./dist/query-batch.js",
      "default": "./dist/query-batch.js"
    },
    "./saga-store": {
      "types": "./dist/saga-store.d.ts",
      "import": "./dist/saga-store.js",
      "default": "./dist/saga-store.js"
    }
  },
  "dependencies": {
    "@applik8s/applik8s": "0.9.0",
    "@applik8s/core": "0.9.0",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7"
  }
}
