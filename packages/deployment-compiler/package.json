{
  "name": "@applik8s/deployment-compiler",
  "version": "0.9.0",
  "description": "Pure ApplicationGraph to ApplicationDeploymentGraph lowering for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/deployment-compiler"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime-access-parity": {
      "types": "./dist/kubernetes-runtime-access-parity.d.ts",
      "import": "./dist/kubernetes-runtime-access-parity.js",
      "default": "./dist/kubernetes-runtime-access-parity.js"
    }
  },
  "dependencies": {
    "@applik8s/core": "0.9.0",
    "@applik8s/deployment-contract": "0.9.0"
  }
}
