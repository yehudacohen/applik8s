{
  "name": "@applik8s/research",
  "version": "0.8.0",
  "description": "Provider-neutral durable research evidence, citation provenance, and specialized research-agent composition for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/research"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime.d.ts",
      "import": "./dist/agent-runtime.js",
      "default": "./dist/agent-runtime.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    }
  },
  "dependencies": {
    "@applik8s/applik8s": "0.8.0",
    "@applik8s/ai": "0.8.0",
    "@applik8s/ai-tanstack": "0.8.0",
    "@applik8s/core": "0.8.0",
    "@applik8s/sdk": "0.8.0",
    "@applik8s/web-search": "0.8.0",
    "@tanstack/ai": "0.45.1",
    "arktype": "2.2.1",
    "postgres": "^3.4.7"
  }
}
