{
  "name": "@applik8s/typekro-adapter",
  "version": "0.7.2",
  "description": "TypeKro integration adapter for applik8s operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/typekro-adapter"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./targets": {
      "types": "./dist/operation-targets.d.ts",
      "import": "./dist/operation-targets.js",
      "default": "./dist/operation-targets.js"
    }
  },
  "dependencies": {
    "@applik8s/compiler": "0.7.2",
    "@applik8s/core": "0.7.2",
    "@applik8s/sdk": "0.7.2",
    "@applik8s/typetainer": "0.7.2",
    "arktype": "2.2.1",
    "typekro": "0.33.7"
  }
}
