{
  "name": "@applik8s/compiler",
  "version": "0.7.1",
  "description": "Compiler and artifact pipeline for applik8s Kubernetes operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/compiler"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/index.d.ts",
      "import": "./dist/diagnostics/index.js",
      "default": "./dist/diagnostics/index.js"
    },
    "./kubernetes-schema": {
      "types": "./dist/kubernetes-schema/index.d.ts",
      "import": "./dist/kubernetes-schema/index.js",
      "default": "./dist/kubernetes-schema/index.js"
    }
  },
  "dependencies": {
    "@bytecodealliance/componentize-js": "^0.21.0",
    "@kubernetes/client-node": "^1.3.0",
    "@applik8s/core": "0.7.1",
    "@applik8s/conversations": "0.7.1",
    "@applik8s/deployment-compiler": "0.7.1",
    "@applik8s/deployment-contract": "0.7.1",
    "@applik8s/runtime-contract": "0.7.1",
    "@applik8s/runtime-s3": "0.7.1",
    "@applik8s/runtime-hatchet": "0.7.1",
    "@applik8s/runtime-nats": "0.7.1",
    "@applik8s/runtime-kubernetes": "0.7.1",
    "@applik8s/runtime-postgres": "0.7.1",
    "@applik8s/runtime-ai": "0.7.1",
    "@applik8s/operations": "0.7.1",
    "@applik8s/identity": "0.7.1",
    "@applik8s/identity-ory": "0.7.1",
    "@applik8s/mcp": "0.7.1",
    "@hatchet-dev/typescript-sdk": "1.24.3",
    "@applik8s/typetainer": "0.7.1",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.1.1",
    "postgres": "^3.4.7",
    "typescript": "^5.3.0",
    "yaml": "^2.9.0"
  }
}
