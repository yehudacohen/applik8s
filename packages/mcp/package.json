{
  "name": "@applik8s/mcp",
  "version": "0.7.1",
  "description": "Provider-neutral MCP transport, catalog pinning, and external-tool trust boundaries for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/mcp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    }
  },
  "dependencies": {
    "@applik8s/core": "0.7.1",
    "@applik8s/operations": "0.7.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
