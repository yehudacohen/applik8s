{
  "name": "@applik8s/sdk",
  "version": "0.7.0",
  "description": "TypeScript authoring SDK for applik8s Kubernetes operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema-runtime": {
      "types": "./dist/schema-runtime.d.ts",
      "import": "./dist/schema-runtime.js",
      "default": "./dist/schema-runtime.js"
    }
  },
  "dependencies": {
    "@applik8s/core": "0.7.0",
    "arktype": "^2.1.20"
  }
}
