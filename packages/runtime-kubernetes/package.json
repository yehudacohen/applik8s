{
  "name": "@applik8s/runtime-kubernetes",
  "version": "0.8.0",
  "description": "Kubernetes API runtime adapters for Applik8s applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/runtime-kubernetes"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./job-runtime": {
      "types": "./dist/job-runtime.d.ts",
      "import": "./dist/job-runtime.js",
      "default": "./dist/job-runtime.js"
    },
    "./managed-model-store": {
      "types": "./dist/managed-model-store.d.ts",
      "import": "./dist/managed-model-store.js",
      "default": "./dist/managed-model-store.js"
    },
    "./operator-runtime": {
      "types": "./dist/operator-runtime.d.ts",
      "import": "./dist/operator-runtime.js",
      "default": "./dist/operator-runtime.js"
    },
    "./cluster-capability": {
      "types": "./dist/cluster-capability.d.ts",
      "import": "./dist/cluster-capability.js",
      "default": "./dist/cluster-capability.js"
    },
    "./workflow-gateway-admission": {
      "types": "./dist/workflow-gateway-admission.d.ts",
      "import": "./dist/workflow-gateway-admission.js",
      "default": "./dist/workflow-gateway-admission.js"
    }
  },
  "dependencies": {
    "@applik8s/applik8s": "0.8.0",
    "@applik8s/core": "0.8.0",
    "@applik8s/runtime-postgres": "0.8.0",
    "@kubernetes/client-node": "^1.3.0"
  }
}
