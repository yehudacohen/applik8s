{
  "name": "@applik8s/ai-tanstack",
  "version": "0.9.0",
  "description": "Native TanStack AI tool, connection, compatibility, and runtime-context adapters for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
