{
  "name": "@applik8s/cli",
  "version": "0.7.0",
  "description": "Build and deployment CLI for Applik8s applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
