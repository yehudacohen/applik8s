    "@applik8s/deployment-typekro": "0.7.0",
    "@kubernetes/client-node": "^1.3.0",
    "arktype": "^2.1.20",
    "cel-js": "0.8.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "typekro": "0.33.5",
    "yaml": "^2.9.0"
