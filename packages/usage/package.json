{
  "name": "@applik8s/usage",
  "version": "0.8.0",
  "description": "Provider-neutral usage, cost, quota, and entitlement accounting models for Applik8s.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/usage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./provider-accounting": {
      "types": "./dist/provider-accounting-api.d.ts",
      "import": "./dist/provider-accounting-api.js",
      "default": "./dist/provider-accounting-api.js"
    },
    "./provider-accounting-runtime": {
      "types": "./dist/provider-accounting.d.ts",
      "import": "./dist/provider-accounting.js",
      "default": "./dist/provider-accounting.js"
    },
    "./provider-accounting-postgres-runtime": {
      "types": "./dist/provider-accounting-postgres.d.ts",
      "import": "./dist/provider-accounting-postgres.js",
      "default": "./dist/provider-accounting-postgres.js"
    }
  },
  "dependencies": {
    "@applik8s/applik8s": "0.8.0",
    "drizzle-orm": "^0.45.1"
  }
}
