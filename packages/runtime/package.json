{
  "name": "@applik8s/runtime",
  "version": "0.9.0",
  "description": "Runtime interfaces for applik8s operators.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehudacohen/applik8s.git",
    "directory": "packages/runtime"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./signed-envelope": {
      "types": "./dist/signed-envelope.d.ts",
      "import": "./dist/signed-envelope.js",
      "default": "./dist/signed-envelope.js"
    },
    "./node-integrity": {
      "types": "./dist/node-integrity.d.ts",
      "import": "./dist/node-integrity.js",
      "default": "./dist/node-integrity.js"
    }
  },
  "dependencies": {
    "@applik8s/core": "0.9.0"
  }
}
